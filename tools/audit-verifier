#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""audit-verifier — EIS 审计链验证（v1.0.0 参考实现）

用途: 哈希链完整性（Schema 校验 + 序列连续、链接衔接、逐条重算）——规范权威见
      05-audit-contract/hash-chain.spec.md，参考实现为 05 的 verify.tool。
      本工具封装 verify.tool，并提供：冻结测试向量校验、测试夹具批量验证。
      验证流程：先按 05-audit-contract/audit.schema.json 逐条校验（schema_invalid），
      再做哈希/链校验；畸形输入转为结构化错误。

用法:
  audit-verifier CHAIN.json [--json]     验证单个链文件
  audit-verifier CHAIN.json --events E.json   复算 payload_digest（事件正文篡改检出）
  audit-verifier --all [--dir D]         验证 D 下全部 *.chain.json（默认全仓库 tests/）
  audit-verifier --vector                校验规范冻结的创世测试向量
  audit-verifier --self-test             向量 + 合法/篡改/缺口/断链 + payload_digest

退出码: 0 通过 / 1 验证失败 / 2 用法或输入错误
"""
from __future__ import annotations

import argparse
import json
import sys
from importlib.machinery import SourceFileLoader
from importlib.util import module_from_spec, spec_from_loader
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))
from eis_common import ROOT, rel  # noqa: E402

VERIFY_TOOL = ROOT / "05-audit-contract" / "verify.tool"

# hash-chain.spec.md §3 冻结测试向量（创世条目）
GENESIS_VECTOR_ENTRY = {
    "id": "018f2e3a-1234-7000-8000-000000000001",
    "sequence": 1,
    "timestamp": "2026-10-08T09:00:00.000000+00:00",
    "actor": "018f2e3a-0000-7000-8000-000000000001",
    "action": "voucher.create",
    "resource": {"type": "voucher", "id": "018f2e3a-9999-7000-8000-000000000002"},
    "payload": {"amount": "100.00", "currency": "CNY"},
    "prev_hash": "0" * 64,
}
GENESIS_VECTOR_HASH = "447c6e299d9adaec35d89e273b15d28752eeaac4674000b5df88d2e53a087410"

# hash-chain.spec.md §3.2 冻结测试向量（含 payload_digest；事件投影与期望值）
GENESIS_DIGEST_PROJECTION = [
    {"id": "018f2e3a-aaaa-7000-8000-000000000001", "type": "voucher.created",
     "payload": {"amount": "100.00", "currency": "CNY"}},
]
GENESIS_DIGEST = "b3a88a20915cc5a9a3c4a5c05e90b32be38b4e3ecafdc5f94d0fe878fb402913"
GENESIS_DIGEST_HASH = "fb4cc4620dba2250bca59861f177e5406e19b35136582386d0e15fb96bb98969"


def load_verify_module():
    loader = SourceFileLoader("eis_verify_tool", str(VERIFY_TOOL))
    module = module_from_spec(spec_from_loader("eis_verify_tool", loader))
    loader.exec_module(module)
    # 透传 verify.tool 的降级警告（jsonschema 缺失 → 仅哈希校验）
    warn = getattr(module, "warn_if_degraded", None)
    if callable(warn):
        warn()
    return module


def check_vector(vt) -> bool:
    return vt.compute_hash(GENESIS_VECTOR_ENTRY) == GENESIS_VECTOR_HASH


def check_digest_vector(vt) -> bool:
    """校验 §3.2 向量：投影摘要与含 digest 条目的哈希均与规范字面值一致。"""
    entry = dict(GENESIS_VECTOR_ENTRY)
    entry["payload_digest"] = GENESIS_DIGEST
    return (vt.compute_payload_digest(GENESIS_DIGEST_PROJECTION) == GENESIS_DIGEST
            and vt.compute_hash(entry) == GENESIS_DIGEST_HASH)


def verify_file(vt, path: Path, events_path: Path | None = None) -> dict:
    try:
        entries = vt.load_entries(str(path))
    except (OSError, ValueError) as exc:
        return {"file": rel(path), "valid": False, "error": f"读取失败: {exc}"}
    errors = []
    if events_path is not None:
        try:
            events = vt.load_entries(str(events_path))
        except (OSError, ValueError) as exc:
            return {"file": rel(path), "valid": False, "error": f"事件导出读取失败: {exc}"}
        errors.extend(vt.verify_payload_digests(entries, events))
    try:
        errors = vt.verify_chain(entries) + errors
    except (ValueError, TypeError, KeyError) as exc:
        return {"file": rel(path), "valid": False,
                "error": f"验证异常（输入畸形）: {type(exc).__name__}: {exc}"}
    return {"file": rel(path), "valid": not errors, "entries": len(entries), "errors": errors}


def cmd_all(args) -> int:
    vt = load_verify_module()
    root = Path(args.dir) if args.dir else ROOT
    fixtures = sorted(root.rglob("*.chain.json"))
    if not fixtures:
        print(f"[ok  ] 未发现 *.chain.json 夹具（{rel(root)}）")
        return 0
    rc = 0
    for path in fixtures:
        result = verify_file(vt, path)
        if result["valid"]:
            print(f"[ok  ] {result['file']}（{result.get('entries', 0)} 条）")
        else:
            rc = 1
            print(f"[FAIL] {result['file']}: {result.get('error') or result['errors']}")
    return rc


def cmd_self_test(args) -> int:
    vt = load_verify_module()
    ok = True

    def report(name, cond):
        nonlocal ok
        print(f"[{'ok  ' if cond else 'FAIL'}] {name}")
        ok = ok and cond

    report("冻结测试向量（hash-chain.spec.md §3）", check_vector(vt))
    report("payload_digest 冻结测试向量（hash-chain.spec.md §3.2）", check_digest_vector(vt))
    chain, prev = [], vt.GENESIS_PREV_HASH
    for seq in (1, 2, 3):
        entry = vt._build_entry(seq, prev)
        chain.append(entry)
        prev = entry["hash"]
    report("合法链通过", not vt.verify_chain(chain))
    import copy

    tampered = copy.deepcopy(chain)
    tampered[1]["payload"]["amount"] = "999.00"
    report("篡改检出（invalid_hash）", any(e["type"] == "invalid_hash" for e in vt.verify_chain(tampered)))
    report("缺口检出（sequence_gap）", any(e["type"] == "sequence_gap" for e in vt.verify_chain([chain[0], chain[2]])))
    broken = copy.deepcopy(chain)
    broken[2]["prev_hash"] = "f" * 64
    broken[2]["hash"] = vt.compute_hash(broken[2])
    report("断链检出（prev_hash_mismatch）",
           any(e["type"] == "prev_hash_mismatch" for e in vt.verify_chain(broken)))

    # 负例：缺必填字段但哈希自洽 → schema_invalid（仅重算哈希会漏判为 valid）
    if getattr(vt, "SCHEMA_VALIDATION_ENABLED", True):
        missing = copy.deepcopy(chain)
        del missing[0]["action"]
        missing[0]["hash"] = vt.compute_hash(missing[0])
        missing_errors = vt.verify_chain(missing)
        report("缺必填字段检出（schema_invalid）",
               any(e["type"] == "schema_invalid" for e in missing_errors)
               and any(e.get("path") for e in missing_errors if e["type"] == "schema_invalid"))
    else:  # pragma: no cover
        print("[skip] 缺必填字段检出（jsonschema 缺失，Schema 校验已降级）")

    # 负例：畸形 timestamp → 结构化错误而非 traceback
    bad_ts = copy.deepcopy(chain)
    bad_ts[1]["timestamp"] = "not-a-date"
    try:
        bad_ts_errors = vt.verify_chain(bad_ts)
        report("畸形 timestamp 结构化报错",
               any(e["type"] in ("schema_invalid", "invalid_hash") for e in bad_ts_errors))
    except Exception as exc:  # noqa: BLE001
        report(f"畸形 timestamp 结构化报错（抛出 {type(exc).__name__}）", False)
    # payload_digest（v1.1）：摘要复算与事件正文篡改检出
    digest_events = [{"id": "018f2e3a-1234-7000-8000-0000000000e1", "type": "voucher.created",
                      "payload": {"amount": "100.00", "currency": "CNY"}}]
    dchain, dprev = [], vt.GENESIS_PREV_HASH
    for dseq, devs in ((1, digest_events), (2, [])):
        de = vt._build_entry(dseq, dprev, payload={"event_ids": [ev["id"] for ev in devs]})
        de["payload_digest"] = vt.compute_payload_digest(devs)
        de["hash"] = vt.compute_hash(de)
        dchain.append(de)
        dprev = de["hash"]
    report("含 payload_digest 的链通过", not vt.verify_chain(dchain))
    report("零事件摘要冻结常量", vt.compute_payload_digest([]) == vt.EMPTY_PAYLOAD_DIGEST)
    tampered_events = copy.deepcopy(digest_events)
    tampered_events[0]["payload"]["amount"] = "999.00"
    report("事件正文篡改检出（payload_digest_mismatch）",
           any(e["type"] == "payload_digest_mismatch"
               for e in vt.verify_payload_digests(dchain, tampered_events)))

    print(f"自测结果: {'通过' if ok else '失败'}")
    return 0 if ok else 1


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(prog="audit-verifier", description="EIS 审计链验证（参考实现）")
    parser.add_argument("chain", nargs="?", help="审计链文件（JSON 数组 / {entries:[...]} / JSONL）")
    parser.add_argument("--events", help="事件导出文件（JSON 数组 / {events:[...]}）；复算 payload_digest")
    parser.add_argument("--json", action="store_true", help="JSON 输出")
    parser.add_argument("--all", action="store_true", help="验证目录下全部 *.chain.json")
    parser.add_argument("--dir", help="配合 --all：扫描目录（默认仓库根）")
    parser.add_argument("--vector", action="store_true", help="校验冻结测试向量")
    parser.add_argument("--self-test", action="store_true", help="自测")
    args = parser.parse_args(argv)

    if args.self_test:
        return cmd_self_test(args)
    if args.vector:
        vt = load_verify_module()
        if check_vector(vt) and check_digest_vector(vt):
            print("[ok  ] 冻结测试向量通过（§3.1 无 digest + §3.2 含 digest）")
            return 0
        print("[FAIL] 冻结测试向量不匹配（实现缺陷）", file=sys.stderr)
        return 1
    if args.all:
        return cmd_all(args)
    if not args.chain:
        parser.print_usage(sys.stderr)
        return 2
    vt = load_verify_module()
    result = verify_file(vt, Path(args.chain), Path(args.events) if args.events else None)
    if args.json:
        print(json.dumps(result, ensure_ascii=False, indent=2))
    elif result["valid"]:
        print(f"审计链验证：通过（{result.get('entries', 0)} 条）")
    else:
        print(f"审计链验证：失败（{result.get('error') or len(result.get('errors', []))} 项）")
        for err in result.get("errors", []):
            print(f"  - [{err['type']}] sequence={err.get('sequence')}: {err.get('message', '')}")
    return 0 if result["valid"] else 1


if __name__ == "__main__":
    raise SystemExit(main())
