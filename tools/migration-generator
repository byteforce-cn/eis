#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""migration-generator — EIS 迁移脚本生成（v1.0.0 参考实现）

用途: 新旧 JSON Schema diff → 迁移 SQL + 回滚 SQL（基于 06-evolution-contract 模板）

用法:
  migration-generator --old A.schema.json --new B.schema.json --table T [--version V] [--out DIR]
  （缺省输出到 stdout；--out 时写入 DIR/migration/V__T.sql 与 DIR/rollback/V__T.sql）
  migration-generator --self-test

说明:
  - SQL 为草案：破坏性变更（删除列）需先完成双写下线与对账，见 migration.template.sql
  - 必填新增列：有 default → ADD COLUMN ... DEFAULT <default> NOT NULL（PG 11+ 安全）；
    无 default → 只生成可空 ADD COLUMN + 回填提示，**不自动** 执行 SET NOT NULL（需回填后再执行）
  - 可空新增列 → ADD COLUMN ...（默认可空）

退出码: 0 生成成功 / 1 用例失败（--self-test）/ 2 用法或输入错误
"""
from __future__ import annotations

import argparse
import json
import re
import sys
import tempfile
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))
from eis_common import load_json  # noqa: E402


def map_type(prop: dict) -> str:
    t = prop.get("type")
    if isinstance(t, list):
        t = next((x for x in t if x != "null"), None)
    fmt = prop.get("format")
    if t == "string":
        if fmt == "uuid":
            return "UUID"
        if fmt == "date-time":
            return "TIMESTAMPTZ(6)"
        if fmt == "date":
            return "DATE"
        if prop.get("enum"):
            return "TEXT"  # 枚举约束由 CHECK 管理（草案从略）
        return "TEXT"
    if t == "integer":
        return "BIGINT"
    if t == "number":
        return "NUMERIC(20,2)"
    if t == "boolean":
        return "BOOLEAN"
    if t in ("object", "array"):
        return "JSONB"
    return "TEXT"


MISSING = object()


def sql_literal(value) -> str:
    """将 JSON Schema default 值转为 SQL 字面量。"""
    if isinstance(value, bool):
        return "TRUE" if value else "FALSE"
    if isinstance(value, (int, float)):
        return str(value)
    if value is None:
        return "NULL"
    return "'" + str(value).replace("'", "''") + "'"


def domain_properties(doc: dict) -> tuple[dict, set]:
    """提取领域属性与 required：顶层 + allOf 内联项。

    allOf 中的外部 $ref 属核心元结构（由 core.ddl 管理），跳过不生成列；
    与 schema-compiler 的 object_fields 口径一致（扩展对象 schema 的领域字段在 allOf[1]）。
    """
    props = dict(doc.get("properties", {}) or {})
    required = set(doc.get("required", []) or [])
    for item in doc.get("allOf", []) or []:
        if not isinstance(item, dict) or "$ref" in item:
            continue
        props.update(item.get("properties", {}) or {})
        required.update(item.get("required", []) or [])
    return props, required


def generate(old: dict, new: dict, table: str, version: str) -> tuple[str, str]:
    op, oreq = domain_properties(old)
    np_, nreq = domain_properties(new)

    mig: list[str] = [
        "-- ============================================================================",
        f"-- migration V{version} — {table}",
        "-- 生成器：tools/migration-generator（草案，须经人工评审与演练）",
        "-- 流程：准备 → 双写 → 切换 → 清理（见 06-evolution-contract/migration.template.sql）",
        "-- ============================================================================",
        "",
    ]
    roll: list[str] = [
        "-- ============================================================================",
        f"-- rollback V{version} — {table}",
        "-- 前提：迁移期间旧结构保留（无破坏性改写），随时可回退；数据丢失不可逆处已标注",
        "-- ============================================================================",
        "",
    ]
    has_change = False

    for name, prop in np_.items():
        if name in op:
            continue
        has_change = True
        sql_type = map_type(prop)
        default = prop.get("default", MISSING)
        # default 仅在为标量（str/int/float/bool）时可安全内联为 DEFAULT；
        # null 视同无 default，list/dict 等非标量必须人工回填。
        scalar_default = default is not MISSING and isinstance(default, (str, int, float, bool))
        if name in nreq and scalar_default:
            mig.append("-- 必填新增列（提供标量 default，可直接 NOT NULL；PG 11+ 常量默认不重写表）")
            mig.append(f"ALTER TABLE {table} ADD COLUMN {name} {sql_type} "
                       f"DEFAULT {sql_literal(default)} NOT NULL;")
        elif name in nreq:
            if default is None:
                reason = "default 为 null，视同无 default"
            elif default is not MISSING and not isinstance(default, (str, int, float, bool)):
                reason = "default 为非标量（list/dict），不生成可执行 DEFAULT"
            else:
                reason = "无 default"
            mig.append(f"-- 必填新增列（{reason}，两阶段：先加可空列，回填后再加非空约束）")
            mig.append(f"ALTER TABLE {table} ADD COLUMN {name} {sql_type};")
            mig.append(f"-- 必须先回填非空值，再执行 SET NOT NULL（本迁移不自动执行）：")
            mig.append(f"--   ALTER TABLE {table} ALTER COLUMN {name} SET NOT NULL")
        else:
            mig.append("-- 可选新增列（默认可空）")
            mig.append(f"ALTER TABLE {table} ADD COLUMN {name} {sql_type};")
        mig.append("")
        roll.append(f"ALTER TABLE {table} DROP COLUMN IF EXISTS {name};")
        roll.append("")

    for name, prop in op.items():
        if name in np_:
            continue
        has_change = True
        mig.append(f"-- 删除列（破坏性：确认双写下线、对账完成、无引用后再执行）")
        mig.append(f"ALTER TABLE {table} DROP COLUMN {name};")
        mig.append("")
        roll.append(f"-- 恢复删除的列（注意：数据无法恢复）")
        roll.append(f"ALTER TABLE {table} ADD COLUMN {name} {map_type(prop)};")
        roll.append("")

    for name, oprop in op.items():
        if name not in np_:
            continue
        nprop = np_[name]
        if otype_str(oprop) == otype_str(nprop):
            continue
        has_change = True
        new_sql = map_type(nprop)
        mig.append(f"-- 类型变更 {otype_str(oprop)} → {otype_str(nprop)}")
        mig.append(f"ALTER TABLE {table} ALTER COLUMN {name} TYPE {new_sql} USING {name}::{new_sql};")
        mig.append("")
        old_sql = map_type(oprop)
        roll.append(f"ALTER TABLE {table} ALTER COLUMN {name} TYPE {old_sql} USING {name}::{old_sql};")
        roll.append("")

    if not has_change:
        mig.append("-- 无结构变更（空迁移）")
        roll.append("-- 无结构变更（空回滚）")

    return "\n".join(mig).rstrip() + "\n", "\n".join(roll).rstrip() + "\n"


def otype_str(prop: dict) -> str:
    t = prop.get("type")
    if isinstance(t, list):
        t = next((x for x in t if x != "null"), None)
    fmt = prop.get("format")
    return f"{t}:{fmt}" if fmt else str(t)


def cmd_self_test(args) -> int:
    ok = True

    def report(name, cond):
        nonlocal ok
        print(f"[{'ok  ' if cond else 'FAIL'}] {name}")
        ok = ok and cond

    old = {"properties": {"a": {"type": "integer"}, "b": {"type": "string"}}, "required": ["a", "b"]}
    new = {"properties": {"b": {"type": "string"}, "c": {"type": "string"},
                          "d": {"type": "string", "format": "date-time"}},
           "required": ["b", "d"]}
    with tempfile.TemporaryDirectory() as tmp:
        mig, roll = generate(old, new, "t_demo", "1.2.0")
        report("生成 ADD COLUMN（可选，不含 NOT NULL）",
               "ADD COLUMN c TEXT;" in mig and not re.search(r"ADD COLUMN c TEXT[^;]*NOT NULL", mig))
        report("必填无 default 不输出 SET NOT NULL 语句",
               not re.search(r"ALTER COLUMN d SET NOT NULL;", mig))
        report("必填无 default 输出回填提示", "回填" in mig and "ADD COLUMN d TIMESTAMPTZ(6);" in mig)
        report("生成 DROP COLUMN", "DROP COLUMN a;" in mig)
        report("回滚含反向 DROP", "DROP COLUMN IF EXISTS c;" in roll)
        report("回滚含反向 ADD", "ADD COLUMN a BIGINT;" in roll)

        # 必填 + default → 单句可执行（DEFAULT ... NOT NULL）
        old_def = {"properties": {"a": {"type": "integer"}}, "required": ["a"]}
        new_def = {"properties": {"a": {"type": "integer"}, "d": {"type": "string", "default": "x"}},
                   "required": ["a", "d"]}
        mig_def, _ = generate(old_def, new_def, "t_demo", "1.3.0")
        report("必填有 default 单句直接 NOT NULL",
               "ADD COLUMN d TEXT DEFAULT 'x' NOT NULL;" in mig_def)

        # 必填 + default=null → 视同无 default，走两阶段、不输出可执行 SET NOT NULL
        new_null = {"properties": {"a": {"type": "integer"}, "d": {"type": "string", "default": None}},
                    "required": ["a", "d"]}
        mig_null, _ = generate(old_def, new_null, "t_demo", "1.4.0")
        report("必填 default=null 走两阶段",
               "ADD COLUMN d TEXT;" in mig_null
               and not re.search(r"ADD COLUMN d \w+ DEFAULT", mig_null)
               and not re.search(r"ALTER COLUMN d SET NOT NULL;", mig_null)
               and "default 为 null" in mig_null)

        # 必填 + 非标量 default（list）→ 两阶段 + 注释说明，不内联 DEFAULT
        new_non = {"properties": {"a": {"type": "integer"}, "d": {"type": "array", "default": [1, 2]}},
                   "required": ["a", "d"]}
        mig_non, _ = generate(old_def, new_non, "t_demo", "1.5.0")
        report("必填非标量 default 走两阶段并注释",
               "非标量" in mig_non
               and not re.search(r"ADD COLUMN d \w+ DEFAULT", mig_non)
               and not re.search(r"ALTER COLUMN d SET NOT NULL;", mig_non))

        # 扩展对象 Schema（allOf[1] 内联领域字段 + allOf[0] 外部 $ref 元结构）
        old_ext = {"allOf": [{"$ref": "../../../01-data-contract/object.schema.json"},
                             {"properties": {"a": {"type": "string"}}, "required": ["a"]}]}
        new_ext = {"allOf": [{"$ref": "../../../01-data-contract/object.schema.json"},
                             {"properties": {"a": {"type": "string"},
                                            "employment_type": {"type": ["string", "null"]}},
                              "required": ["a"]}]}
        mig_ext, roll_ext = generate(old_ext, new_ext, "hr_employee", "1.1.0")
        report("allOf 扩展 Schema 生成可选新增列",
               "ADD COLUMN employment_type TEXT;" in mig_ext
               and "DROP COLUMN IF EXISTS employment_type;" in roll_ext)
        report("allOf 外部 $ref 元结构被跳过（不报错、不生成元列）",
               "ADD COLUMN id TEXT" not in mig_ext and "ADD COLUMN valid_from" not in mig_ext)

        out = Path(tmp) / "migration"
        out.mkdir()
        (out / f"V1.2.0__t_demo.sql").write_text(mig, encoding="utf-8")
        (out.parent / "rollback").mkdir()
        (out.parent / "rollback" / f"V1.2.0__t_demo.sql").write_text(roll, encoding="utf-8")
        report("写出迁移/回滚文件", (out / "V1.2.0__t_demo.sql").exists()
               and (out.parent / "rollback" / "V1.2.0__t_demo.sql").exists())
    print(f"自测结果: {'通过' if ok else '失败'}")
    return 0 if ok else 1


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(prog="migration-generator", description="EIS 迁移脚本生成（参考实现）")
    parser.add_argument("--old", help="旧 Schema（JSON）")
    parser.add_argument("--new", dest="new", help="新 Schema（JSON）")
    parser.add_argument("--table", help="目标表名")
    parser.add_argument("--version", default="x.y.z", help="目标版本（用于文件名）")
    parser.add_argument("--out", help="输出目录（缺省打印到 stdout）")
    parser.add_argument("--self-test", action="store_true", help="自测")
    args = parser.parse_args(argv)

    if args.self_test:
        return cmd_self_test(args)
    if not (args.old and args.new and args.table):
        parser.print_usage(sys.stderr)
        return 2
    try:
        old, new = load_json(args.old), load_json(args.new)
    except (OSError, json.JSONDecodeError) as exc:
        print(f"输入错误: {exc}", file=sys.stderr)
        return 2
    mig, roll = generate(old, new, args.table, args.version)
    if args.out:
        base = Path(args.out)
        (base / "migration").mkdir(parents=True, exist_ok=True)
        (base / "rollback").mkdir(parents=True, exist_ok=True)
        mig_path = base / "migration" / f"V{args.version}__{args.table}.sql"
        roll_path = base / "rollback" / f"V{args.version}__{args.table}.sql"
        mig_path.write_text(mig, encoding="utf-8")
        roll_path.write_text(roll, encoding="utf-8")
        print(f"[ok  ] 迁移: {mig_path}")
        print(f"[ok  ] 回滚: {roll_path}")
    else:
        print("-- migration.sql --")
        print(mig)
        print("-- rollback.sql --")
        print(roll)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
