def load_fixtures(path: str) -> dict:
    return load_yaml(Path(path))


def cmd_self_test(args) -> int:
    # 确定性夹具
    P_AWAY = "01900000-0000-7000-8000-000000000001"   # 被代理人（休假）
    P_AGENT = "01900000-0000-7000-8000-000000000002"  # 代理人
    P_BOTH = "01900000-0000-7000-8000-000000000003"   # 同时持有冲突权限
    R_APPROVE = "01900000-0000-7000-8000-0000000000a1"
    R_CREATE = "01900000-0000-7000-8000-0000000000a2"
    fixtures = {
        "fixtures": {
            "principals": [
                {"id": P_AWAY, "type": "person", "key": "away", "valid_from": "2026-01-01T00:00:00Z", "recorded_at": "2026-01-01T00:00:00Z"},
                {"id": P_AGENT, "type": "person", "key": "agent", "valid_from": "2026-01-01T00:00:00Z", "recorded_at": "2026-01-01T00:00:00Z"},
                {"id": P_BOTH, "type": "person", "key": "both", "valid_from": "2026-01-01T00:00:00Z", "recorded_at": "2026-01-01T00:00:00Z"},
            ],
            "roles": [
                {"id": R_APPROVE, "key": "approver", "permissions": ["purchase.request.approve"], "valid_from": "2026-01-01T00:00:00Z", "recorded_at": "2026-01-01T00:00:00Z"},
                {"id": R_CREATE, "key": "requester", "permissions": ["purchase.request.create"], "valid_from": "2026-01-01T00:00:00Z", "recorded_at": "2026-01-01T00:00:00Z"},
            ],
            "bindings": [
                {"id": "01900000-0000-7000-8000-0000000000b1", "principal": P_AWAY, "role": R_APPROVE, "scope": {"department": "D001"}, "valid_from": "2026-10-01T00:00:00Z", "recorded_at": "2026-10-01T00:00:00Z"},
                {"id": "01900000-0000-7000-8000-0000000000b2", "principal": P_BOTH, "role": R_APPROVE, "scope": {"department": "D001"}, "valid_from": "2026-01-01T00:00:00Z", "recorded_at": "2026-01-01T00:00:00Z"},
                {"id": "01900000-0000-7000-8000-0000000000b3", "principal": P_BOTH, "role": R_CREATE, "scope": {"department": "D001"}, "valid_from": "2026-01-01T00:00:00Z", "recorded_at": "2026-01-01T00:00:00Z"},
            ],
            "proxies": [
                {"id": "01900000-0000-7000-8000-0000000000c1", "principal": P_AWAY, "agent": P_AGENT, "scope": {"department": "D001"}, "valid_from": "2026-10-01T00:00:00Z", "valid_to": "2026-11-01T00:00:00Z", "recorded_at": "2026-10-01T00:00:00Z"},
            ],
            "attributes": [
                {"principal": P_AWAY, "as_of": "2026-10-01T00:00:00Z", "recorded_at": "2026-10-01T00:00:00Z",
                 "expires_at": "2026-11-01T00:00:00Z", "source": "hr",
                 "snapshot": {"employee_status": "active", "employment_type": "full_time",
                              "primary_position": {"position_id": "01900000-0000-7000-8000-0000000000d1",
                                                   "code": "P001", "title": "经理", "grade": "M2",
                                                   "org_unit_id": "01900000-0000-7000-8000-0000000000e1",
                                                   "org_unit_code": "D001", "is_primary": True}}},
            ],
        }
    }
    a = Authz(fixtures)
    report = []

    def expect(name, cond):
        report.append((name, cond))

    # 1. 历史时点（授权生效前）拒绝
    r = a.check("away", "purchase.request.approve", "2026-09-30T12:00:00Z")
    expect("生效前时点拒绝（NO_PERMISSION）", r["allowed"] is False and r["reason_code"] == "NO_PERMISSION")
    # 2. 生效后直接授权
    r = a.check("away", "purchase.request.approve", "2026-10-15T12:00:00Z")
    expect("生效后直接授权允许", r["allowed"] is True)
    # 3. 代理在代理期内可行权
    r = a.check("agent", "purchase.request.approve", "2026-10-15T12:00:00Z")
    expect("代理期内可行权", r["allowed"] is True)
    # 4. 代理期外拒绝
    r = a.check("agent", "purchase.request.approve", "2026-11-15T12:00:00Z")
    expect("代理期外拒绝", r["allowed"] is False)
    # 5. SoD-001 prevent：同时持有 create+approve → 拒绝
    r = a.check("both", "purchase.request.approve", "2026-10-15T12:00:00Z")
    expect("SoD-001 prevent 拒绝", r["allowed"] is False and r["reason_code"] == "SOD-001")
    # 6. resolve 输出角色
    r = a.resolve("agent", "2026-10-15T12:00:00Z")
    expect("代理解析出被代理人角色", "approver" in r["roles"])
    # 7. 属性快照：新鲜 / 过期 / 缺失
    attrs = a.attributes("away", "2026-10-15T12:00:00Z")
    expect("属性快照新鲜（fresh）", attrs["attribute_state"] == "fresh"
           and attrs["snapshot"]["primary_position"]["grade"] == "M2")
    attrs = a.attributes("away", "2026-11-15T12:00:00Z")
    expect("属性快照过期（stale）", attrs["attribute_state"] == "stale"
           and attrs["reason_code"] == "ATTRIBUTE_STALE")
    attrs = a.attributes("away", "2026-09-30T12:00:00Z")
    expect("无属性快照（missing）", attrs["attribute_state"] == "missing"
           and attrs["reason_code"] == "ATTRIBUTE_MISSING")
    # 8. 属性条件：匹配通过 / 不匹配拒绝 / 过期 fail-closed
    r = a.check("away", "purchase.request.approve", "2026-10-15T12:00:00Z",
                require_attributes={"primary_position.grade": "M2"})
    expect("属性条件匹配允许", r["allowed"] is True and r["attribute_state"] == "fresh")
    r = a.check("away", "purchase.request.approve", "2026-10-15T12:00:00Z",
                require_attributes={"primary_position.grade": "P5"})
    expect("属性条件不匹配拒绝", r["allowed"] is False and r["reason_code"] == "ATTRIBUTE_MISMATCH")
    r = a.check("away", "purchase.request.approve", "2026-11-15T12:00:00Z",
                require_attributes={"primary_position.grade": "M2"})
    expect("过期属性 fail-closed", r["allowed"] is False and r["reason_code"] == "ATTRIBUTE_STALE")
    # 9. 不依赖属性的判定不受影响
    r = a.check("away", "purchase.request.approve", "2026-10-15T12:00:00Z")
    expect("不依赖属性的判定不受影响", r["allowed"] is True)

    failed = [name for name, cond in report if not cond]
    for name, cond in report:
        print(f"[{'ok  ' if cond else 'FAIL'}] {name}")
    print(f"-- {len(report) - len(failed)} 通过, {len(failed)} 失败")
    return 0 if not failed else 1


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(prog="authz-resolver", description="EIS 授权解析（参考实现）")
    parser.add_argument("--self-test", action="store_true", help="自测（内置夹具）")
    sub = parser.add_subparsers(dest="cmd")

    def add_common(p):
        p.add_argument("--fixtures", required=True, help="夹具文件（YAML/JSON）")
        p.add_argument("--principal", required=True, help="主体（UUID 或 key）")
        p.add_argument("--as-of", required=True, dest="as_of", help="业务时点（RFC 3339）")
        p.add_argument("--recorded-as-of", dest="recorded_as_of", help="系统时点（可选）")

    p_resolve = sub.add_parser("resolve", help="解析角色/权限")
    add_common(p_resolve)
    p_resolve.add_argument("--scope-json", dest="scope_json", help="作用域过滤（JSON）")

    p_check = sub.add_parser("check", help="检查权限")
    add_common(p_check)
    p_check.add_argument("--permission", required=True)
    p_check.add_argument("--require-attribute", action="append", default=[], metavar="KEY=VALUE",
                         help="属性条件（可重复）；缺失/过期/不匹配 fail-closed（ATR-006/007）")

    p_sod = sub.add_parser("sod-check", help="列出 SoD 冲突")
    add_common(p_sod)

    p_attrs = sub.add_parser("attributes", help="拉取属性快照（ATR-002）")
    add_common(p_attrs)

    args = parser.parse_args(argv)
    if args.self_test:
        return cmd_self_test(args)
    if args.cmd is None:
        parser.print_help()
        return 2
    try:
        authz = Authz(load_fixtures(args.fixtures))
    except (OSError, KeyError) as exc:
        print(f"夹具加载失败: {exc}", file=sys.stderr)
        return 2
    if args.cmd == "resolve":
        scope_filter = json.loads(args.scope_json) if args.scope_json else None
        out = authz.resolve(args.principal, args.as_of, args.recorded_as_of, scope_filter)
    elif args.cmd == "check":
        require = {}
        for item in args.require_attribute:
            key, sep, value = item.partition("=")
            if not sep or not key:
                print(f"--require-attribute 需形如 KEY=VALUE: {item}", file=sys.stderr)
                return 2
            require[key] = value
        out = authz.check(args.principal, args.permission, args.as_of, args.recorded_as_of,
                          require or None)
    elif args.cmd == "attributes":
        out = authz.attributes(args.principal, args.as_of, args.recorded_as_of)
    else:
        p = authz.principal(args.principal)
        out = {"sod_conflicts": authz._sod_conflicts(p["id"], parse_ts(args.as_of), None, "prevent")}
    print(json.dumps(out, ensure_ascii=False, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
