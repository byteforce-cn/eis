#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""authz-resolver — EIS 授权解析（v1.0.0 参考实现）

语义（见 04-authz-contract/）:
  - 双时间轴：as_of（业务时间）筛选 valid 区间；recorded_as_of（系统时间）筛选记录区
  - 代理：agent 可在代理范围内行使被代理人（principal）的角色
  - SoD：同一作用域内同时持有冲突权限 → prevent 拒绝（reason_code=SOD-xxx）/ warn 上报

用法:
  authz-resolver resolve --fixtures F --principal P --as-of T [--recorded-as-of T] [--scope-json J]
  authz-resolver check   --fixtures F --principal P --permission X --as-of T [--recorded-as-of T]
  authz-resolver sod-check --fixtures F --principal P --as-of T
  authz-resolver --self-test

主体可按 UUID 或 key 引用。输出为 JSON。

退出码: 0 成功 / 1 判定失败（仅 self-test 时用作断言） / 2 用法或输入错误
"""
from __future__ import annotations

import argparse
import json
import sys
from datetime import datetime, timezone
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))
from eis_common import ROOT, load_yaml  # noqa: E402

SOD_RULES_PATH = ROOT / "04-authz-contract" / "sod.rules.yaml"

SCOPE_KEYS = {
    "same_department": "department",
    "same_organization": "organization",
    "same_warehouse": "warehouse",
}

_MISSING = object()


def _attr_get(node, path: str):
    """按点分路径读取快照嵌套值；缺失返回 _MISSING。"""
    cursor = node
    for part in path.split("."):
        if isinstance(cursor, dict) and part in cursor:
            cursor = cursor[part]
        elif isinstance(cursor, list) and part.isdigit() and int(part) < len(cursor):
            cursor = cursor[int(part)]
        else:
            return _MISSING
    return cursor


# ---------------------------------------------------------------------------
# 时间
# ---------------------------------------------------------------------------
def parse_ts(value) -> datetime:
    if isinstance(value, datetime):
        dt = value
    else:
        dt = datetime.fromisoformat(str(value).replace("Z", "+00:00"))
    if dt.tzinfo is None:
        dt = dt.replace(tzinfo=timezone.utc)
    return dt.astimezone(timezone.utc)


def in_range(entity: dict, as_of: datetime, recorded_as_of: datetime | None) -> bool:
    """双时间轴命中：半开区间 [from, to)。"""
    valid_from = entity.get("valid_from")
    valid_to = entity.get("valid_to")
    if valid_from is not None and parse_ts(valid_from) > as_of:
        return False
    if valid_to is not None and parse_ts(valid_to) <= as_of:
        return False
    if recorded_as_of is not None:
        recorded_at = entity.get("recorded_at")
        superseded_at = entity.get("superseded_at")
        if recorded_at is not None and parse_ts(recorded_at) > recorded_as_of:
            return False
        if superseded_at is not None and parse_ts(superseded_at) <= recorded_as_of:
            return False
    return True


# ---------------------------------------------------------------------------
# 授权解析
# ---------------------------------------------------------------------------
class Authz:
    def __init__(self, fixtures: dict, sod_rules: list[dict] | None = None):
        fx = fixtures.get("fixtures", fixtures)
        self.principals = fx.get("principals", [])
        self.roles = fx.get("roles", [])
        self.bindings = fx.get("bindings", [])
        self.proxies = fx.get("proxies", [])
        self.attribute_snapshots = fx.get("attributes", [])
        if sod_rules is None:
            sod_rules = load_yaml(SOD_RULES_PATH).get("sod_rules", [])
        self.sod_rules = sod_rules
        self._roles_by_id = {r["id"]: r for r in self.roles}
        self._roles_by_key = {r.get("key"): r for r in self.roles}
        self._principals_by_ref = {}
        for p in self.principals:
            self._principals_by_ref[p["id"]] = p
            if p.get("key"):
                self._principals_by_ref[p["key"]] = p

    # -- 查询工具 ---------------------------------------------------------
    def principal(self, ref: str) -> dict:
        p = self._principals_by_ref.get(ref)
        if p is None:
            raise KeyError(f"主体不存在: {ref}")
        return p

    def role_of(self, binding: dict) -> dict | None:
        role_ref = binding.get("role")
        return self._roles_by_id.get(role_ref) or self._roles_by_key.get(role_ref)

    def scope_matches(self, binding_scope: dict | None, scope_filter: dict | None) -> bool:
        if not scope_filter:
            return True
        binding_scope = binding_scope or {}
        if not binding_scope:
            return True  # 全局授权
        for key, value in scope_filter.items():
            if key in binding_scope and binding_scope[key] != value:
                return False
        return True

    def proxy_grants(self, agent_id: str, as_of: datetime, recorded_as_of):
        """agent 可行使的被代理人授权集合：[(principal_id, scope, proxy)]。"""
        grants = []
        for proxy in self.proxies:
            if proxy.get("agent") != agent_id:
                continue
            if not in_range(proxy, as_of, recorded_as_of):
                continue
            grants.append((proxy["principal"], proxy.get("scope") or {}, proxy))
        return grants

    def _grants(self, principal_id: str, as_of, recorded_as_of, include_proxy=True):
        """返回 [(binding, role, scope, source)]，含代理展开。"""
        out = []
        for b in self.bindings:
            if b.get("principal") != principal_id:
                continue
            if not in_range(b, as_of, recorded_as_of):
                continue
            role = self.role_of(b)
            if role and in_range(role, as_of, recorded_as_of):
                out.append((b, role, b.get("scope") or {}, "direct"))
        if include_proxy:
            for proxy_principal, proxy_scope, _proxy in self.proxy_grants(principal_id, as_of, recorded_as_of):
                for b in self.bindings:
                    if b.get("principal") != proxy_principal:
                        continue
                    if not in_range(b, as_of, recorded_as_of):
                        continue
                    b_scope = b.get("scope") or {}
                    # 代理范围约束：代理 scope 限定的键必须与绑定一致
                    if any(b_scope.get(k) != v for k, v in (proxy_scope or {}).items()):
                        continue
                    role = self.role_of(b)
                    if role and in_range(role, as_of, recorded_as_of):
                        out.append((b, role, b_scope, "proxy"))
        return out

    # -- 对外操作 ---------------------------------------------------------
    def resolve(self, principal_ref: str, as_of, recorded_as_of=None, scope_filter=None) -> dict:
        p = self.principal(principal_ref)
        as_of_dt = parse_ts(as_of)
        recorded_dt = parse_ts(recorded_as_of) if recorded_as_of else None
        roles, permissions = [], []
        for _b, role, scope, _src in self._grants(p["id"], as_of_dt, recorded_dt):
            if not self.scope_matches(scope, scope_filter):
                continue
            key = role.get("key") or role.get("id")
            if key not in roles:
                roles.append(key)
            for perm in role.get("permissions", []):
                if perm not in permissions:
                    permissions.append(perm)
        warnings = self._sod_conflicts(p["id"], as_of_dt, recorded_dt, mode="warn")
        return {
            "principal": p["id"],
            "as_of": as_of_dt.isoformat().replace("+00:00", "Z"),
            "roles": roles,
            "permissions": permissions,
            "sod_warnings": [w["rule"] for w in warnings],
        }

    # -- 属性快照（ATR-002/004/006）--------------------------------------
    def attributes(self, principal_ref: str, as_of, recorded_as_of=None) -> dict:
        """按 principal + as_of 选最新快照；无快照 → missing，过期 → stale。"""
        p = self.principal(principal_ref)
        as_of_dt = parse_ts(as_of)
        recorded_dt = parse_ts(recorded_as_of) if recorded_as_of else None
        candidates = []
        for item in self.attribute_snapshots:
            if item.get("principal") not in (p["id"], p.get("key")):
                continue
            snap_as_of = parse_ts(item.get("as_of") or item.get("recorded_at"))
            if snap_as_of > as_of_dt:
                continue
            if recorded_dt is not None and item.get("recorded_at") is not None \
                    and parse_ts(item["recorded_at"]) > recorded_dt:
                continue
            candidates.append(item)
        base = {"principal": p["id"],
                "as_of": as_of_dt.isoformat().replace("+00:00", "Z")}
        if not candidates:
            return {**base, "recorded_at": None, "expires_at": None,
                    "source": "hr", "attribute_state": "missing",
                    "reason_code": "ATTRIBUTE_MISSING", "snapshot": None}
        item = max(candidates, key=lambda x: parse_ts(x.get("as_of") or x.get("recorded_at")))
        expires = item.get("expires_at")
        stale = expires is not None and parse_ts(expires) <= as_of_dt
        return {
            **base,
            "recorded_at": item.get("recorded_at"),
            "expires_at": expires,
            "source": item.get("source", "hr"),
            "source_version": item.get("source_version"),
            "attribute_state": "stale" if stale else "fresh",
            "reason_code": "ATTRIBUTE_STALE" if stale else None,
            "snapshot": item.get("snapshot", {}),
        }

    def _attribute_gate(self, principal_ref, as_of, recorded_as_of, require_attributes):
        """属性条件门禁；返回 None 表示通过，否则返回拒绝结果（fail-closed）。"""
        if not require_attributes:
            return None
        attrs = self.attributes(principal_ref, as_of, recorded_as_of)
        state = attrs["attribute_state"]
        if state == "missing":
            return {"allowed": False, "reason": f"属性缺失（fail-closed），无法求值: {sorted(require_attributes)}",
                    "reason_code": "ATTRIBUTE_MISSING", "warnings": [], "attribute_state": state}
        if state == "stale":
            return {"allowed": False, "reason": "属性快照过期（fail-closed）",
                    "reason_code": "ATTRIBUTE_STALE", "warnings": [], "attribute_state": state}
        for key, expected in require_attributes.items():
            actual = _attr_get(attrs["snapshot"], key)
            if actual != expected:
                return {"allowed": False, "reason": f"属性条件不满足: {key}",
                        "reason_code": "ATTRIBUTE_MISMATCH", "warnings": [],
                        "attribute_state": state}
        return None

    def check(self, principal_ref: str, permission: str, as_of, recorded_as_of=None,
              require_attributes=None) -> dict:
        p = self.principal(principal_ref)
        as_of_dt = parse_ts(as_of)
        recorded_dt = parse_ts(recorded_as_of) if recorded_as_of else None
        # 属性条件先于权限判定：缺失/过期/不匹配均 fail-closed（ATR-006/007）
        gate = self._attribute_gate(p["id"], as_of, recorded_as_of, require_attributes)
        if gate is not None:
            return gate
        held = []
        for _b, role, scope, _src in self._grants(p["id"], as_of_dt, recorded_dt):
            for perm in role.get("permissions", []):
                held.append((perm, scope))
        if not any(perm == permission for perm, _ in held):
            return {"allowed": False, "reason": f"主体在 {as_of} 无权限 {permission}",
                    "reason_code": "NO_PERMISSION", "warnings": []}
        # prevent 级 SoD：请求的权限与已持有权限同作用域冲突 → 拒绝
        for rule in self.sod_rules:
            if permission not in rule.get("conflicting_permissions", []):
                continue
            others = [perm for perm, _ in held if perm in rule["conflicting_permissions"] and perm != permission]
            if not others:
                continue
            key = SCOPE_KEYS.get(rule.get("scope"))
            if self._conflicts_in_scope(permission, others, held, key):
                if rule.get("enforcement") == "prevent":
                    return {"allowed": False,
                            "reason": f"违反职责分离 {rule['id']}（{rule.get('name')}）",
                            "reason_code": rule["id"], "warnings": []}
        warnings = [w["rule"] for w in self._sod_conflicts(p["id"], as_of_dt, recorded_dt, mode="warn")]
        result = {"allowed": True, "reason": "允许", "reason_code": "ALLOWED", "warnings": warnings}
        if require_attributes:
            result["attribute_state"] = self.attributes(principal_ref, as_of, recorded_as_of)["attribute_state"]
        return result

    def _conflicts_in_scope(self, permission, others, held, scope_key) -> bool:
        scopes_a = [s for perm, s in held if perm == permission]
        for other in others:
            scopes_b = [s for perm, s in held if perm == other]
            for sa in scopes_a:
                for sb in scopes_b:
                    if scope_key is None:
                        return True
                    va, vb = sa.get(scope_key), sb.get(scope_key)
                    if va is not None and va == vb:
                        return True
                    if va is None and vb is None:
                        return True
        return False

    def _sod_conflicts(self, principal_id, as_of_dt, recorded_dt, mode) -> list[dict]:
        held = []
        for _b, role, scope, _src in self._grants(principal_id, as_of_dt, recorded_dt):
            for perm in role.get("permissions", []):
                held.append((perm, scope))
        conflicts = []
        for rule in self.sod_rules:
            if rule.get("enforcement") != mode:
                continue
            perms = rule.get("conflicting_permissions", [])
            present = [perm for perm in perms if any(h == perm for h, _ in held)]
            if len(present) < 2:
                continue
            key = SCOPE_KEYS.get(rule.get("scope"))
            if self._conflicts_in_scope(present[0], present[1:], held, key):
                conflicts.append({"rule": rule["id"], "name": rule.get("name"), "permissions": present})
        return conflicts


