def cmd_self_test(args) -> int:
    report = Report("contract-checker --self-test")
    if Draft202012Validator is None:
        report.fail("缺少依赖 jsonschema（pip install jsonschema）")
        report.print()
        return 2
    # 构造一个非法命令 API：缺少 idempotency_key 与 409 响应
    import tempfile

    bad = {
        "openapi": "3.1.0",
        "info": {"title": "t", "version": "1.0.0"},
        "paths": {
            "/commands/x.y": {
                "post": {
                    "operationId": "op1",
                    "requestBody": {"content": {"application/json": {"schema": {"type": "object"}}}},
                    "responses": {"202": {"description": "ok"}},
                }
            }
        },
    }
    with tempfile.TemporaryDirectory() as tmp:
        p = Path(tmp) / "bad.openapi.yaml"
        import yaml as _yaml

        p.write_text(_yaml.safe_dump(bad, allow_unicode=True), encoding="utf-8")
        tmp_report = Report("tmp")
        # 直接复用检查逻辑（打补丁方式：临时替换文件列表）
        global openapi_files  # noqa: PLW0603
        orig = openapi_files
        openapi_files = lambda: [p]
        try:
            check_openapi(tmp_report)
        finally:
            openapi_files = orig
        if tmp_report.success:
            report.fail("自测：非法命令 API 未被检出")
        else:
            report.ok("自测：非法命令 API 被正确检出（缺 idempotency_key / 响应）")

    # PG 保留字：字段名 primary（保留字）必须被拒绝并给出替代名；is_primary 不受影响
    base = {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "eis://selftest/reserved-word/v1",
        "title": "ReservedWord",
        "allOf": [
            {"$ref": "../../01-data-contract/object.schema.json"},
            {"type": "object", "properties": {"primary": {"type": "boolean"}}},
        ],
    }
    ok_schema = {
        **base,
        "$id": "eis://selftest/reserved-word-ok/v1",
        "allOf": [
            {"$ref": "../../01-data-contract/object.schema.json"},
            {"type": "object", "properties": {"is_primary": {"type": "boolean"}}},
        ],
    }
    with tempfile.TemporaryDirectory() as tmp:
        (Path(tmp) / "a" / "b").mkdir(parents=True)
        (Path(tmp) / "01-data-contract").mkdir()
        (Path(tmp) / "01-data-contract" / "object.schema.json").write_text("{}", encoding="utf-8")
        bad_path = Path(tmp) / "a" / "b" / "bad.schema.json"
        bad_path.write_text(json.dumps(base, ensure_ascii=False), encoding="utf-8")
        ok_path = Path(tmp) / "a" / "b" / "ok.schema.json"
        ok_path.write_text(json.dumps(ok_schema, ensure_ascii=False), encoding="utf-8")
        global schema_files  # noqa: PLW0603
        orig_schemas = schema_files
        bad_report = Report("tmp")
        schema_files = lambda: [bad_path]
        try:
            check_schemas(bad_report)
        finally:
            schema_files = orig_schemas
        detail = "\n".join(str(d) for _, _, d in bad_report.failures)
        if bad_report.success or "保留字" not in detail or "is_primary" not in detail:
            report.fail("自测：PG 保留字字段未被正确拒绝（应报保留字并建议 is_primary）")
        else:
            report.ok("自测：PG 保留字字段被拒绝并给出建议名")
        ok_report = Report("tmp")
        schema_files = lambda: [ok_path]
        try:
            check_schemas(ok_report)
        finally:
            schema_files = orig_schemas
        if ok_report.success:
            report.ok("自测：非保留字字段不受影响")
        else:
            report.fail("自测：非保留字字段被误拒绝")

    # 单文件检查（--file）：$ref 可解析必须通过，坏引用必须被拒，未知类型退出 2
    with tempfile.TemporaryDirectory() as tmp:
        (Path(tmp) / "01-data-contract").mkdir()
        (Path(tmp) / "01-data-contract" / "object.schema.json").write_text("{}", encoding="utf-8")
        base_doc = {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "eis://selftest/file-check/v1",
            "title": "FileCheck",
            "allOf": [{"$ref": "01-data-contract/object.schema.json"}],
        }
        good_path = Path(tmp) / "good.schema.json"
        good_path.write_text(json.dumps(base_doc, ensure_ascii=False), encoding="utf-8")
        good_report = Report("tmp")
        check_schemas(good_report, files=[good_path])
        if good_report.success:
            report.ok("自测：单文件 Schema 检查（含 $ref）通过")
        else:
            report.fail("自测：单文件 Schema 检查误报："
                        + "; ".join(str(d) for _, _, d in good_report.failures))
        bad_path = Path(tmp) / "bad-ref.schema.json"
        bad_path.write_text(json.dumps({
            **base_doc,
            "$id": "eis://selftest/file-check-bad/v1",
            "allOf": [{"$ref": "01-data-contract/missing.schema.json"}],
        }, ensure_ascii=False), encoding="utf-8")
        bad_report = Report("tmp")
        check_schemas(bad_report, files=[bad_path])
        detail = "\n".join(str(d) for _, _, d in bad_report.failures)
        if bad_report.success or "文件不存在" not in detail:
            report.fail("自测：单文件 $ref 坏引用未被检出")
        else:
            report.ok("自测：单文件 $ref 坏引用被检出")
        unknown = Path(tmp) / "note.txt"
        unknown.write_text("x", encoding="utf-8")
        if main(["--file", str(unknown)]) == 2:
            report.ok("自测：--file 未知类型退出 2")
        else:
            report.fail("自测：--file 未知类型未退出 2")

    # 扩展权限目录：未声明引用必须被拒；非命名空间 id 必须被拒
    import tempfile as _tempfile

    import yaml as _yaml

    with _tempfile.TemporaryDirectory() as tmp:
        ext_dir = Path(tmp) / "extensions" / "demo"
        (ext_dir / "tests").mkdir(parents=True)
        (ext_dir / "manifest.yaml").write_text(
            _yaml.safe_dump({
                "extension": {
                    "id": "demo", "version": "1.0.0", "core_version": "1.0.0",
                    "permissions": [
                        {"id": "demo.thing.read", "kind": "read", "description": "读事物"},
                        {"id": "other.thing.read", "kind": "read", "description": "越界"},
                    ],
                },
            }, allow_unicode=True, sort_keys=False), encoding="utf-8")
        (ext_dir / "tests" / "demo.test.yaml").write_text(
            _yaml.safe_dump({"tests": [{"kind": "authz", "permission": "demo.thing.write"}]},
                            allow_unicode=True, sort_keys=False), encoding="utf-8")
        tmp_report = Report("tmp")
        check_manifests(tmp_report, root=Path(tmp))
        detail = "\n".join(str(d) for _, _, d in tmp_report.failures)
        if tmp_report.success or "未声明" not in detail or "命名空间" not in detail:
            report.fail("自测：扩展权限目录校验未生效（应报未声明引用与非命名空间 id）")
        else:
            report.ok("自测：扩展权限未声明引用与非命名空间 id 被拒")

    # 动态属主权限：仅尾部 .* 通配；必须段边界匹配，不得放宽为任意前缀
    with _tempfile.TemporaryDirectory() as tmp:
        ext_dir = Path(tmp) / "extensions" / "demo"
        (ext_dir / "tests").mkdir(parents=True)
        (ext_dir / "manifest.yaml").write_text(
            _yaml.safe_dump({
                "extension": {
                    "id": "demo", "version": "1.0.0", "core_version": "1.0.0",
                    "permissions": [
                        {"id": "demo.section.confirm.*", "kind": "command",
                         "description": "区块属主确认（动态 owner）"},
                    ],
                },
            }, allow_unicode=True, sort_keys=False), encoding="utf-8")

        def check_ref(ref: str) -> tuple[bool, str]:
            (ext_dir / "tests" / "demo.test.yaml").write_text(
                _yaml.safe_dump({"tests": [{"kind": "authz", "permission": ref}]},
                                allow_unicode=True, sort_keys=False), encoding="utf-8")
            tmp_report = Report("tmp")
            check_manifests(tmp_report, root=Path(tmp))
            return tmp_report.success, "\n".join(str(d) for _, _, d in tmp_report.failures)

        matched, detail = check_ref("demo.section.confirm.ops")
        if matched:
            report.ok("自测：通配声明匹配属主子权限")
        else:
            report.fail("自测：通配声明未匹配属主子权限", detail)
        for bad_ref in ("demo.section.confirm", "demo.section.confirmx"):
            matched, detail = check_ref(bad_ref)
            if not matched and "未声明" in detail:
                report.ok(f"自测：通配不得匹配 {bad_ref}")
            else:
                report.fail(f"自测：通配错误匹配 {bad_ref}", detail)

    # 命令调用方约束（ADR-0013）：投影与 manifest 双向一致；非法枚举必须被拒
    with _tempfile.TemporaryDirectory() as tmp:
        root = Path(tmp)
        ext_dir = root / "extensions" / "demo"
        (ext_dir / "operations").mkdir(parents=True)

        def write_caller_case(manifest_callers, op_callers) -> None:
            permission = {"id": "demo.run", "kind": "command", "description": "执行"}
            if manifest_callers is not None:
                permission["callers"] = manifest_callers
            (ext_dir / "manifest.yaml").write_text(
                _yaml.safe_dump({"extension": {
                    "id": "demo", "version": "1.0.0", "core_version": "1.0.0",
                    "operations": [{"name": "demoRun", "contract": "operations/run.openapi.yaml"}],
                    "permissions": [permission],
                }}, allow_unicode=True, sort_keys=False), encoding="utf-8")
            op = {"operationId": "demoRun", "responses": {"202": {"description": "ok"}}}
            if op_callers is not None:
                op[CALLER_EXTENSION] = op_callers
            (ext_dir / "operations" / "run.openapi.yaml").write_text(
                _yaml.safe_dump({
                    "openapi": "3.1.0", "info": {"title": "t", "version": "1.0.0"},
                    "paths": {"/commands/demo.run": {"post": op}},
                }, allow_unicode=True, sort_keys=False), encoding="utf-8")

        def caller_report() -> Report:
            r = Report("tmp")
            manifests = check_manifests(r, root=root)
            check_operation_callers(r, manifests, root=root)
            return r

        write_caller_case(["system"], ["system"])
        if caller_report().success:
            report.ok("自测：调用方约束声明与投影一致时通过")
        else:
            report.fail("自测：调用方约束一致时误报")
        for manifest_callers, op_callers, label in (
            (None, ["system"], "投影缺声明"),
            (["system"], None, "声明缺投影"),
            (["system"], ["person"], "声明与投影不一致"),
            (["service"], ["service"], "非法主体类型"),
        ):
            write_caller_case(manifest_callers, op_callers)
            if caller_report().success:
                report.fail(f"自测：调用方约束漂移未被检出（{label}）")
            else:
                report.ok(f"自测：调用方约束漂移被检出（{label}）")

    # 授权条件声明（ADR-0015）：路径必须落在 04 属性快照内；op/结构白名单；不得嵌套
    with _tempfile.TemporaryDirectory() as tmp:
        root = Path(tmp)
        ext_dir = root / "extensions" / "demo"
        ext_dir.mkdir(parents=True)

        def condition_report(condition) -> Report:
            (ext_dir / "manifest.yaml").write_text(
                _yaml.safe_dump({"extension": {
                    "id": "demo", "version": "1.0.0", "core_version": "1.0.0",
                    "permissions": [{
                        "id": "demo.thing.read", "kind": "read", "description": "读事物",
                        "condition": condition,
                    }],
                }}, allow_unicode=True, sort_keys=False), encoding="utf-8")
            r = Report("tmp")
            check_manifests(r, root=root)
            return r

        good = {"all": [
            {"attribute": "primary_position.grade", "op": "in", "values": ["M2", "P1"]},
            {"attribute": "positions[*].grade", "op": "not_in", "values": ["P9"]},
        ]}
        if condition_report(good).success:
            report.ok("自测：合法授权条件声明通过（主岗/任一岗位路径）")
        else:
            report.fail("自测：合法授权条件声明被误拒")
        for bad, label, expected in (
            ({"all": [{"attribute": "primary_position.rank", "op": "eq", "values": ["x"]}]},
             "未知属性路径", "不在 04 属性快照"),
            ({"all": [{"attribute": "primary_position.grade", "op": "regex", "values": ["P.*"]}]},
             "op 越界", "op 不在白名单"),
            ({"all": [{"attribute": "primary_position.grade", "op": "eq", "values": []}]},
             "空 values", "非空数组"),
            ({"all": [{"attribute": "primary_position.grade", "op": "eq", "values": ["M2"]}],
              "any": []}, "all/any 混合", "只能包含"),
            ({"all": [{"attribute": "positions[*]", "op": "eq", "values": ["P6"]}]},
             "整体对象/数组路径", "不在 04 属性快照"),
            ({"all": [{"attribute": "primary_position.grade", "op": "exists",
                       "values": ["yes"]}]}, "exists 非布尔", "[true] 或 [false]"),
        ):
            r = condition_report(bad)
            detail = "\n".join(str(d) for _, _, d in r.failures)
            if r.success or expected not in detail:
                report.fail(f"自测：非法授权条件未被检出（{label}）", detail)
            else:
                report.ok(f"自测：非法授权条件被检出（{label}）")
    report.print()
    return 0 if report.success else 1


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(prog="contract-checker", description="EIS 契约检查（参考实现）")
    parser.add_argument("--json", action="store_true", help="JSON 输出")
    parser.add_argument("--verbose", action="store_true", help="输出全部明细")
    parser.add_argument("--self-test", action="store_true", help="自测")
    parser.add_argument("--file", metavar="PATH",
                        help="单文件检查（*.schema.json / *.openapi.yaml / *.api.yaml / *.asyncapi.yaml）")
    args = parser.parse_args(argv)

    if args.self_test:
        return cmd_self_test(args)

    if args.file:
        path = Path(args.file)
        report = Report(f"contract-checker — 单文件检查（{args.file}）")
        if path.name.endswith(".schema.json"):
            check_schemas(report, files=[path])
        elif path.name.endswith((".openapi.yaml", ".api.yaml")):
            check_openapi(report, files=[path])
        elif path.name.endswith(".asyncapi.yaml"):
            check_asyncapi(report, files=[path])
        else:
            print("--file 仅支持 *.schema.json / *.openapi.yaml / *.api.yaml / *.asyncapi.yaml",
                  file=sys.stderr)
            return 2
        if args.json:
            print(json.dumps(report.to_json(), ensure_ascii=False, indent=2))
        else:
            report.print(verbose=True)
        return 0 if report.success else 1

    report = Report("contract-checker — EIS 契约检查")
    check_schemas(report)
    check_openapi(report)
    check_query_time_points(report)
    check_asyncapi(report)
    check_error_codes(report)
    manifests = check_manifests(report)
    check_operation_callers(report, manifests)
    check_compositions(report, manifests)
    if args.json:
        print(json.dumps(report.to_json(), ensure_ascii=False, indent=2))
    else:
        report.print(verbose=args.verbose)
    return 0 if report.success else 1


if __name__ == "__main__":
    raise SystemExit(main())
