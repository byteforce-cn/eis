#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""compatibility-checker — EIS 兼容性检查（v1.0.0 参考实现）

用途: 新旧 JSON Schema diff → 依据 06-evolution-contract/compatibility.rules.yaml
      判定 MAJOR / MINOR / PATCH，并列出所需配套动作（migration / dual_write / rollback 等）

用法:
  compatibility-checker --old A.schema.json --new B.schema.json [--json] [--fail-on MAJOR|MINOR]
  compatibility-checker --old A.schema.json --new B.schema.json --standalone   # 不读规则文件（内置缺省）
  compatibility-checker --old A.schema.json --new B.schema.json --rules R.yaml
  compatibility-checker --self-test

独立运行: 核心判定在 tools/lib/eis_compat.py（纯 stdlib，零 EIS 运行时依赖）。
  按原目录结构复制本脚本与 tools/lib/eis_compat.py 即可脱离本仓库；--standalone
  仅需两个契约文件（内置缺省与规则文件四条数据规则逐项一致）。规则文件的机器可读
  Schema 为 06-evolution-contract/compatibility.rules.schema.json。

退出码: 0 通过（未触发 --fail-on）/ 1 触发 --fail-on 阈值或判定失败 / 2 用法或输入错误

规则 → 实现映射（Step 1，对照 compatibility.rules.yaml 的 data 规则）:
  | 规则文件条目        | 级别  | 实现 kind        | 触发条件                                   |
  | 字段删除            | MAJOR | 字段删除         | 属性在 new.properties 中缺失               |
  | 字段类型变更        | MAJOR | 字段类型变更     | type/format 变化（任意嵌套层级）           |
  | 可选字段新增        | MINOR | 可选字段新增     | new 新增属性且非 required                  |
  | 必填字段新增        | MAJOR | 必填字段新增     | new 新增/收紧 required                     |
  规则表未单列约束关键词，下列为工具扩展，级别沿用 00-freeze/version-policy.md §2 的
  “破坏性=MAJOR（字段删除/类型变更/必填新增/语义变更）/ 向后兼容新增=MINOR（可选新增等）”：
  | （扩展）约束收紧    | MAJOR | 约束收紧         | maxLength↓/minimum↑/新增 pattern 等        |
  | （扩展）约束放宽    | MINOR | 约束放宽         | maxLength↑/minimum↓/移除 pattern 等        |
  | （扩展）必填放宽    | MINOR | 必填放宽         | required 中删除字段                        |
  | （扩展）枚举取值收缩| MAJOR | 枚举取值收缩     | enum 取值集合收窄                          |
  | （扩展）枚举取值扩展| MINOR | 枚举取值扩展     | enum 取值集合扩张                          |
  | （扩展）$ref 无法解析| MAJOR| $ref 无法解析    | 本地 $ref 无法解析或循环（保守判 MAJOR）   |
  | （扩展）递归过深    | MAJOR | 递归过深         | 超过 MAX_DIFF_DEPTH 层（防 $ref 自引用图）  |

递归范围：properties / items / allOf / anyOf / oneOf 逐项下钻（本仓扩展对象 schema 的
领域字段位于 allOf[1]，必须递归 allOf 才能判出变更）。
"""

from __future__ import annotations

import argparse
import json
import sys
import tempfile
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))
from eis_compat import (  # noqa: E402
    LEVEL_ORDER,
    build_rule_index,
    classify,
    diff_schemas,
)

RULES_PATH = (Path(__file__).resolve().parent.parent
              / "06-evolution-contract" / "compatibility.rules.yaml")
RULES_SCHEMA_PATH = RULES_PATH.with_name("compatibility.rules.schema.json")
# run_check 默认哨兵：加载仓库规则文件；显式传 None = standalone 内置缺省
_REPO_RULES = object()


def load_json(path):
    with open(path, encoding="utf-8") as fh:
        return json.load(fh)


def validate_rules_doc(doc: dict) -> list[str]:
    """按 compatibility.rules.schema.json 校验规则文档；jsonschema 缺失时降级为空。"""
    try:
        from jsonschema import Draft202012Validator
    except ImportError:  # pragma: no cover
        return []
    with open(RULES_SCHEMA_PATH, encoding="utf-8") as fh:
        schema = json.load(fh)
    errors = sorted(Draft202012Validator(schema).iter_errors(doc),
                    key=lambda e: list(e.path))
    return ["$" + "".join(f"[{p!r}]" for p in e.path) + f": {e.message}" for e in errors]


def load_rules(path: Path) -> dict:
    """加载规则文件并做 Schema 校验；失败以退出码 2 终止。"""
    try:
        import yaml
    except ImportError:  # pragma: no cover
        print("错误: 读取规则文件需要 PyYAML（pip install pyyaml）；或使用 --standalone",
              file=sys.stderr)
        raise SystemExit(2)
    try:
        with open(path, encoding="utf-8") as fh:
            doc = yaml.safe_load(fh) or {}
    except OSError as exc:
        print(f"错误: 无法读取规则文件 {path}: {exc}", file=sys.stderr)
        raise SystemExit(2)
    except Exception as exc:  # yaml.YAMLError 等
        print(f"错误: 规则文件解析失败 {path}: {exc}", file=sys.stderr)
        raise SystemExit(2)
    problems = validate_rules_doc(doc)
    if problems:
        print("错误: 规则文件不符合 compatibility.rules.schema.json:", file=sys.stderr)
        for p in problems:
            print(f"  - {p}", file=sys.stderr)
        raise SystemExit(2)
    return build_rule_index(doc)


def run_check(old_path: str, new_path: str, rule_index=_REPO_RULES) -> dict:
    old, new = load_json(old_path), load_json(new_path)
    if rule_index is _REPO_RULES:
        rule_index = load_rules(RULES_PATH)
    return classify(diff_schemas(old, new), rule_index)


def cmd_self_test(args) -> int:
    ok = True

    def report(name, cond):
        nonlocal ok
        print(f"[{'ok  ' if cond else 'FAIL'}] {name}")
        ok = ok and cond

    with tempfile.TemporaryDirectory() as tmp:
        def write(name, doc):
            p = Path(tmp) / name
            p.write_text(json.dumps(doc), encoding="utf-8")
            return str(p)

        base = {
            "properties": {
                "a": {"type": "integer"},
                "b": {"type": "string"},
            },
            "required": ["a", "b"],
        }
        # 1) 字段删除 + 类型变更 → MAJOR，且 requires 完整
        new1 = {
            "properties": {
                "b": {"type": "integer"},          # 类型变更
                "c": {"type": "string"},           # 可选新增
            },
            "required": ["b"],
        }
        r = run_check(write("old1.json", base), write("new1.json", new1))
        kinds = {ch["kind"] for ch in r["changes"]}
        report("检出字段删除", "字段删除" in kinds)
        report("检出类型变更", "字段类型变更" in kinds)
        report("判定整体 MAJOR", r["overall"] == "MAJOR")
        by_kind = {ch["kind"]: ch for ch in r["changes"]}
        report("字段删除要求 migration/dual_write/rollback",
               set(by_kind["字段删除"]["requires"]) == {"migration", "dual_write", "rollback"})
        # 2) 仅可选新增 → MINOR
        new2 = {"properties": dict(base["properties"], z={"type": "string"}), "required": ["a", "b"]}
        r = run_check(write("old2.json", base), write("new2.json", new2))
        report("仅可选新增判定 MINOR", r["overall"] == "MINOR")
        # 3) 完全一致 → PATCH（无变更）
        r = run_check(write("old3.json", base), write("new3.json", base))
        report("无变更判定 PATCH", r["overall"] == "PATCH" and not r["changes"])
        # 4) 必填新增 → MAJOR + 需要 backfill
        new4 = {"properties": dict(base["properties"], n={"type": "string"}), "required": ["a", "b", "n"]}
        r = run_check(write("old4.json", base), write("new4.json", new4))
        ch = next(ch for ch in r["changes"] if ch["kind"] == "必填字段新增")
        report("必填新增要求 backfill", "backfill" in ch["requires"])

        # 5) 顶层约束收紧（maxLength↓ / minimum↑ / 新增 pattern）→ MAJOR
        tighten_old = {"properties": {
            "s": {"type": "string", "maxLength": 10},
            "n": {"type": "integer", "minimum": 1},
        }, "required": ["s", "n"]}
        tighten_new = {"properties": {
            "s": {"type": "string", "maxLength": 5, "pattern": "^[a-z]+$"},
            "n": {"type": "integer", "minimum": 5},
        }, "required": ["s", "n"]}
        r = run_check(write("tighten_old.json", tighten_old), write("tighten_new.json", tighten_new))
        report("顶层约束收紧判定 MAJOR", r["overall"] == "MAJOR")
        report("检出 maxLength 收紧", any("maxLength" in ch.get("detail", "") for ch in r["changes"]))
        report("检出 minimum 收紧", any("minimum" in ch.get("detail", "") for ch in r["changes"]))
        report("检出 pattern 新增", any(ch.get("detail", "").startswith("pattern") for ch in r["changes"]))

        # 6) 顶层约束放宽（maxLength↑ / 移除 pattern）→ MINOR
        loose_old = {"properties": {"s": {"type": "string", "maxLength": 5, "pattern": "^[a-z]+$"}},
                     "required": ["s"]}
        loose_new = {"properties": {"s": {"type": "string", "maxLength": 10}}, "required": ["s"]}
        r = run_check(write("loose_old.json", loose_old), write("loose_new.json", loose_new))
        report("顶层约束放宽判定 MINOR", r["overall"] == "MINOR")
        report("放宽检出约束放宽", any(ch["kind"] == "约束放宽" for ch in r["changes"]))

        # 7) 嵌套对象属性类型变更 → MAJOR
        nest_old = {"properties": {"o": {"type": "object", "properties": {"x": {"type": "string"}},
                                          "required": ["x"]}}, "required": ["o"]}
        nest_new = {"properties": {"o": {"type": "object", "properties": {"x": {"type": "integer"}},
                                          "required": ["x"]}}, "required": ["o"]}
        r = run_check(write("nest_old.json", nest_old), write("nest_new.json", nest_new))
        report("嵌套类型变更判定 MAJOR", r["overall"] == "MAJOR")
        report("嵌套类型变更命中 o.x", any(ch["kind"] == "字段类型变更" and ch["prop"] == "o.x"
                                            for ch in r["changes"]))

        # 8) 嵌套必填新增 / 删除 → MAJOR / MINOR
        nreq_old = {"properties": {"o": {"type": "object", "properties": {
            "x": {"type": "string"}, "y": {"type": "string"}}}}, "required": ["o"]}
        nreq_new = {"properties": {"o": {"type": "object", "properties": {
            "x": {"type": "string"}, "y": {"type": "string"}}, "required": ["x"]}}, "required": ["o"]}
        r = run_check(write("nreq_old.json", nreq_old), write("nreq_new.json", nreq_new))
        report("嵌套必填新增判定 MAJOR", r["overall"] == "MAJOR"
               and any(ch["kind"] == "必填字段新增" for ch in r["changes"]))
        r = run_check(write("nreq_new.json", nreq_new), write("nreq_old.json", nreq_old))
        report("嵌套必填删除判定 MINOR", r["overall"] == "MINOR"
               and any(ch["kind"] == "必填放宽" for ch in r["changes"]))

        # 9) $ref（本地 $defs）内部约束收紧 → MAJOR
        ref_old = {"$defs": {"Amount": {"type": "string", "maxLength": 10}},
                   "properties": {"a": {"$ref": "#/$defs/Amount"}}, "required": ["a"]}
        ref_new = {"$defs": {"Amount": {"type": "string", "maxLength": 5}},
                   "properties": {"a": {"$ref": "#/$defs/Amount"}}, "required": ["a"]}
        r = run_check(write("ref_old.json", ref_old), write("ref_new.json", ref_new))
        report("$ref 内部约束收紧判定 MAJOR", r["overall"] == "MAJOR"
               and any(ch["kind"] == "约束收紧" for ch in r["changes"]))

        # 10) $ref 无法解析 → 保守判 MAJOR 并输出原因
        ref_bad = {"properties": {"a": {"$ref": "#/$defs/Missing"}}, "required": ["a"]}
        r = run_check(write("ref_old.json", ref_old), write("ref_bad.json", ref_bad))
        report("$ref 无法解析保守判 MAJOR", r["overall"] == "MAJOR"
               and any(ch["kind"] == "$ref 无法解析" for ch in r["changes"]))

        # 11-13) allOf 递归（本仓扩展对象 schema 的领域字段在 allOf[1]；allOf[0] 为同一外部 $ref）
        ext_ref = {"$ref": "../../../01-data-contract/object.schema.json"}
        allof_old = {"allOf": [ext_ref, {"type": "object",
                                         "properties": {"x": {"type": "string", "maxLength": 10}}}]}
        # 11) allOf 内字段类型变更 → MAJOR
        allof_typenew = {"allOf": [ext_ref, {"type": "object",
                                             "properties": {"x": {"type": "integer", "maxLength": 10}}}]}
        r = run_check(write("allof_old.json", allof_old), write("allof_type.json", allof_typenew))
        report("allOf 内类型变更判定 MAJOR", r["overall"] == "MAJOR"
               and any(ch["kind"] == "字段类型变更" for ch in r["changes"]))
        # 12) allOf 内约束收紧 → MAJOR
        allof_tighten = {"allOf": [ext_ref, {"type": "object",
                                              "properties": {"x": {"type": "string", "maxLength": 5}}}]}
        r = run_check(write("allof_old.json", allof_old), write("allof_tighten.json", allof_tighten))
        report("allOf 内约束收紧判定 MAJOR", r["overall"] == "MAJOR"
               and any(ch["kind"] == "约束收紧" for ch in r["changes"]))
        # 13) allOf 内可选字段新增 → MINOR
        allof_add = {"allOf": [ext_ref, {"type": "object", "properties": {
            "x": {"type": "string", "maxLength": 10}, "y": {"type": "string"}}}]}
        r = run_check(write("allof_old.json", allof_old), write("allof_add.json", allof_add))
        report("allOf 内可选字段新增判定 MINOR", r["overall"] == "MINOR"
               and any(ch["kind"] == "可选字段新增" for ch in r["changes"]))

        # 14) $ref 自引用图 → 深度上限防 RecursionError，保守判 MAJOR
        selfref = {"$defs": {"Node": {"type": "object",
                                        "properties": {"child": {"$ref": "#/$defs/Node"}},
                                        "required": ["child"]}},
                   "properties": {"root": {"$ref": "#/$defs/Node"}}, "required": ["root"]}
        r = run_check(write("selfref.json", selfref), write("selfref2.json", selfref))
        report("$ref 自引用图触发深度上限（保守 MAJOR）", r["overall"] == "MAJOR"
               and any(ch["kind"] == "递归过深" for ch in r["changes"]))

        # 15-19) 独立模式（standalone）：不读规则文件，使用内置缺省 requires
        same = {"properties": {"a": {"type": "string"}}, "required": ["a"]}
        r = run_check(write("sa_same_old.json", same), write("sa_same_new.json", same), None)
        report("standalone：无变更判定 PATCH", r["overall"] == "PATCH" and not r["changes"])

        optional = {"properties": {"a": {"type": "string"}, "b": {"type": "integer"}},
                    "required": ["a"]}
        r = run_check(write("sa_old.json", same), write("sa_optional.json", optional), None)
        report("standalone：可选字段新增判定 MINOR", r["overall"] == "MINOR")

        breaking = {"properties": {"b": {"type": "integer"}}, "required": ["b"]}
        r_break = run_check(write("sa_old.json", same), write("sa_breaking.json", breaking), None)
        report("standalone：字段删除判定 MAJOR", r_break["overall"] == "MAJOR")

        renamed = {"properties": {"b": {"type": "string"}}, "required": []}
        r = run_check(write("sa_old.json", same), write("sa_renamed.json", renamed), None)
        kinds = {ch["kind"] for ch in r["changes"]}
        report("standalone：重命名（删除+可选新增）判定 MAJOR", r["overall"] == "MAJOR"
               and "字段删除" in kinds and "可选字段新增" in kinds)

        retyped = {"properties": {"a": {"type": "integer"}}, "required": ["a"]}
        r = run_check(write("sa_old.json", same), write("sa_retyped.json", retyped), None)
        report("standalone：类型变更判定 MAJOR", r["overall"] == "MAJOR"
               and any(ch["kind"] == "字段类型变更" for ch in r["changes"]))

        # 内置 requires 必须与仓库规则文件一致（字段删除）
        r_repo = run_check(write("sa_old.json", same), write("sa_breaking.json", breaking))
        repo_del = next(ch for ch in r_repo["changes"] if ch["kind"] == "字段删除")
        standalone_del = next(ch for ch in r_break["changes"] if ch["kind"] == "字段删除")
        report("standalone 内置 requires 与规则文件一致",
               standalone_del["requires"] == repo_del["requires"])

        # 规则文档 Schema：非法 level 必须被拒
        bad_rules = {"version": "1.0.0", "compatibility": {"data": [
            {"rule": "字段删除", "level": "BOGUS", "requires": []}]}}
        report("规则文档 Schema 拒绝非法 level", bool(validate_rules_doc(bad_rules)))
    print(f"自测结果: {'通过' if ok else '失败'}")
    return 0 if ok else 1


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(prog="compatibility-checker", description="EIS 兼容性检查（参考实现）")
    parser.add_argument("--old", help="旧 Schema（JSON）")
    parser.add_argument("--new", dest="new", help="新 Schema（JSON）")
    parser.add_argument("--json", action="store_true", help="JSON 输出")
    parser.add_argument("--fail-on", choices=list(LEVEL_ORDER), dest="fail_on",
                        help="达到该级别（含）时退出码为 1")
    parser.add_argument("--standalone", action="store_true",
                        help="独立模式：不读取仓库规则文件，使用内置缺省 requires")
    parser.add_argument("--rules", help="规则文件路径（覆盖默认 compatibility.rules.yaml）")
    parser.add_argument("--self-test", action="store_true", help="自测")
    args = parser.parse_args(argv)

    if args.self_test:
        return cmd_self_test(args)
    if not (args.old and args.new):
        parser.print_usage(sys.stderr)
        return 2
    if args.rules:
        rule_index = load_rules(Path(args.rules))
    elif args.standalone or not RULES_PATH.exists():
        if not args.standalone:
            print("提示: 未找到规则文件，降级为内置缺省（等同 --standalone）", file=sys.stderr)
        rule_index = None
    else:
        rule_index = _REPO_RULES
    try:
        result = run_check(args.old, args.new, rule_index)
    except (OSError, json.JSONDecodeError) as exc:
        print(f"输入错误: {exc}", file=sys.stderr)
        return 2
    if args.json:
        print(json.dumps(result, ensure_ascii=False, indent=2))
    else:
        print(f"判定: {result['overall']}（{len(result['changes'])} 处变更）")
        for ch in result["changes"]:
            req = f" requires={','.join(ch['requires'])}" if ch["requires"] else ""
            detail = f"（{ch['detail']}）" if ch.get("detail") else ""
            print(f"  [{ch['level']}] {ch['kind']}: {ch['prop']}{detail}{req}")
    if args.fail_on and LEVEL_ORDER[result["overall"]] >= LEVEL_ORDER[args.fail_on] and result["changes"]:
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
