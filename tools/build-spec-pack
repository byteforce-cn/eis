# bin/eis-spec.js：生成物，Node 内建模块，零第三方依赖
BIN_TEMPLATE = """#!/usr/bin/env node
// eis-spec — EIS 规格包 CLI（生成物；Node >= 18；零第三方依赖）
// 用法:
//   eis-spec manifest [--json]        查看 MANIFEST 摘要（--json 输出全量）
//   eis-spec verify [--no-python]     复算 MANIFEST 哈希；默认运行包内冻结向量自检
// 退出码: 0 通过 / 1 校验失败 / 2 用法错误
"use strict";

const fs = require("fs");
const path = require("path");
const crypto = require("crypto");
const { spawnSync } = require("child_process");

const ROOT = path.resolve(__dirname, "..");
const MANIFEST_PATH = path.join(ROOT, "MANIFEST.json");

function fail(message, code) {
  console.error("[FAIL] " + message);
  process.exit(code === undefined ? 1 : code);
}

function readManifest() {
  if (!fs.existsSync(MANIFEST_PATH)) {
    fail("缺少 MANIFEST.json：" + MANIFEST_PATH);
  }
  return JSON.parse(fs.readFileSync(MANIFEST_PATH, "utf8"));
}

function sha256(file) {
  return crypto.createHash("sha256").update(fs.readFileSync(file)).digest("hex");
}

function verifyManifest(manifest) {
  const problems = [];
  for (const entry of manifest.files || []) {
    const target = path.join(ROOT, entry.path);
    if (!fs.existsSync(target)) {
      problems.push("缺少文件: " + entry.path);
      continue;
    }
    const size = fs.statSync(target).size;
    if (size !== entry.size) {
      problems.push("大小不一致: " + entry.path + "（清单 " + entry.size + "，实际 " + size + "）");
    }
    if (sha256(target) !== entry.sha256) {
      problems.push("哈希不一致: " + entry.path);
    }
  }
  return problems;
}

function cmdManifest(argv) {
  const manifest = readManifest();
  if (argv.includes("--json")) {
    process.stdout.write(JSON.stringify(manifest, null, 2) + "\\n");
    return;
  }
  console.log("package: " + manifest.package_name);
  console.log("spec_version: " + manifest.spec_version);
  console.log("generated_at: " + manifest.generated_at);
  console.log("source_commit: " + (manifest.source_commit || "(unknown)"));
  console.log("files: " + manifest.files.length);
}

function cmdVerify(argv) {
  const manifest = readManifest();
  const problems = verifyManifest(manifest);
  if (problems.length > 0) {
    problems.forEach(function (problem) { console.error("[FAIL] " + problem); });
    process.exit(1);
  }
  console.log("[ok  ] MANIFEST 校验通过（" + manifest.files.length + " 个文件）");
  if (argv.includes("--no-python")) {
    return;
  }
  const python = process.env.PYTHON || (process.platform === "win32" ? "python" : "python3");
  const checks = [
    ["05-audit-contract/verify.tool", "--self-test"],
    ["tools/audit-verifier", "--vector"],
    ["tools/contract-checker"],
  ];
  for (const args of checks) {
    const proc = spawnSync(python, [path.join(ROOT, args[0])].concat(args.slice(1)), {
      cwd: ROOT,
      env: Object.assign({}, process.env, { PYTHONDONTWRITEBYTECODE: "1" }),
      stdio: ["ignore", "inherit", "inherit"],
    });
    if (proc.error) {
      fail("无法运行 " + python + ": " + proc.error.message + "（可用 --no-python 跳过）");
    }
    if (proc.status !== 0) {
      fail("自检失败: " + args.join(" ") + "（退出码 " + proc.status + "）");
    }
  }
}

const argv = process.argv.slice(2);
const command = argv[0];
if (command === "manifest") {
  cmdManifest(argv.slice(1));
} else if (command === "verify") {
  cmdVerify(argv.slice(1));
} else {
  console.error("用法: eis-spec manifest [--json] | eis-spec verify [--no-python]");
  process.exit(2);
}
"""

