# ---------------------------------------------------------------------------
# 工具函数
# ---------------------------------------------------------------------------
def _iter_files(base: Path):
    for path in sorted(base.rglob("*")):
        if not path.is_file():
            continue
        rel = path.relative_to(base)
        if any(part in EXCLUDE_DIRS for part in rel.parts):
            continue
        if path.suffix in EXCLUDE_SUFFIXES:
            continue
        yield path


def _sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with open(path, "rb") as fh:
        for chunk in iter(lambda: fh.read(65536), b""):
            digest.update(chunk)
    return digest.hexdigest()


def _spec_version() -> str:
    """规范版本唯一来源：acceptance.yaml 的 version。"""
    text = (ROOT / "acceptance.yaml").read_text(encoding="utf-8")
    match = re.search(r'^version:\s*"([^"]+)"', text, re.M)
    if not match:
        raise SystemExit("[FAIL] acceptance.yaml 缺少 version 字段（规范版本唯一来源）")
    return match.group(1)


def _source_commit():
    try:
        proc = subprocess.run(["git", "-C", str(ROOT), "rev-parse", "HEAD"],
                              capture_output=True, text=True, timeout=10)
        if proc.returncode == 0:
            return proc.stdout.strip()
    except (OSError, subprocess.SubprocessError):
        pass
    return None


def _generated_at() -> str:
    epoch = os.environ.get("SOURCE_DATE_EPOCH", "")
    if epoch.isdigit():
        moment = datetime.fromtimestamp(int(epoch), timezone.utc)
    else:
        moment = datetime.now(timezone.utc)
    return moment.strftime("%Y-%m-%dT%H:%M:%SZ")


def _entry(pack: Path, path: str, source: str, kind: str) -> dict:
    target = pack / path
    return {"path": path, "source": source, "kind": kind,
            "sha256": _sha256(target), "size": target.stat().st_size}


def _npm_package_json(version: str) -> dict:
    """npm/pnpm 包形态的 package.json（生成物，不手工维护）。"""
    return {
        "name": NPM_PACKAGE_NAME,
        "version": version,
        "description": "EIS specification pack generated from canonical sources "
                       "(six contracts, frozen vectors, reference tools)",
        "license": "Apache-2.0",
        "repository": {"type": "git", "url": "git+https://github.com/byteforce-cn/eis.git"},
        "homepage": "https://github.com/byteforce-cn/eis",
        "bugs": {"url": "https://github.com/byteforce-cn/eis/issues"},
        "engines": {"node": ">=18"},
        "files": [*CONTRACT_DIRS, "tools", "vectors", "bin", "MANIFEST.json",
                  "README.md", "LICENSE", "NOTICE"],
        "bin": {"eis-spec": "./bin/eis-spec.js"},
        "exports": {
            ".": "./MANIFEST.json",
            "./manifest": "./MANIFEST.json",
            "./contracts/*": "./*",
            "./vectors/*": "./vectors/*",
            "./rules": "./06-evolution-contract/compatibility.rules.yaml",
            "./tools/*": "./tools/*",
        },
        "publishConfig": {"access": "public"},
    }


# ---------------------------------------------------------------------------
# 构建与校验
# ---------------------------------------------------------------------------
def build_pack(out: Path, *, generated_at: str | None = None, commit: str | None = None,
               npm: bool = False, npm_version: str | None = None) -> dict:
    """构建规格包到 out（清空重建），返回 MANIFEST 字典。

    npm=True 时附加 pnpm/npm 包形态；npm_version 覆盖包版本（nightly/预发布），
    默认 = 规范版本（acceptance.yaml），MANIFEST 同时记录两者。
    """
    out = Path(out).resolve()
    if out.exists():
        shutil.rmtree(out)
    out.mkdir(parents=True)
    spec_version = _spec_version()
    package_version = npm_version or spec_version

    files: list[dict] = []
    for contract in CONTRACT_DIRS:
        for src in _iter_files(ROOT / contract):
            rel = src.relative_to(ROOT).as_posix()
            dest = out / rel
            dest.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(src, dest)
            files.append(_entry(out, rel, rel, "contract"))
    for tool_rel in TOOL_FILES:
        src = ROOT / tool_rel
        dest = out / tool_rel
        dest.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(src, dest)
        files.append(_entry(out, tool_rel, tool_rel, "tool"))
    for src_dir, pack_dir in VECTOR_DIRS:
        for src in _iter_files(ROOT / src_dir):
            pack_rel = f"{pack_dir}/{src.name}"
            dest = out / pack_rel
            dest.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(src, dest)
            files.append(_entry(out, pack_rel, f"{src_dir}/{src.name}", "vector"))

    if npm:
        bin_dir = out / "bin"
        bin_dir.mkdir()
        bin_script = bin_dir / "eis-spec.js"
        bin_script.write_text(BIN_TEMPLATE, encoding="utf-8")
        bin_script.chmod(0o755)
        files.append(_entry(out, "bin/eis-spec.js", "(generated:npm)", "packaging"))
        for name in ("LICENSE", "NOTICE"):
            shutil.copy2(ROOT / name, out / name)
            files.append(_entry(out, name, name, "packaging"))
        (out / "package.json").write_text(
            json.dumps(_npm_package_json(package_version), ensure_ascii=False, indent=2) + "\n",
            encoding="utf-8")
        files.append(_entry(out, "package.json", "(generated:npm)", "packaging"))

    manifest = {
        "pack_schema_version": PACK_SCHEMA_VERSION,
        "package_name": NPM_PACKAGE_NAME,
        "package_version": package_version,
        "spec_version": spec_version,
        "generated_at": generated_at or _generated_at(),
        "source_commit": commit if commit is not None else _source_commit(),
        "generator": "tools/build-spec-pack",
        "files": sorted(files, key=lambda item: item["path"]),
    }
    readme = README_TEMPLATE.substitute(
        spec_version=spec_version,
        generated_at=manifest["generated_at"],
        source_commit=manifest["source_commit"] or "(unknown)",
        file_count=len(manifest["files"]) + 1,  # 含 README.md 自身
        npm_section=NPM_SECTION_TEMPLATE.substitute(spec_version=package_version) if npm else "",
    )
    (out / "README.md").write_text(readme, encoding="utf-8")
    manifest["files"].append(_entry(out, "README.md", "(generated)", "generated"))
    manifest["files"].sort(key=lambda item: item["path"])
    (out / "MANIFEST.json").write_text(
        json.dumps(manifest, ensure_ascii=False, indent=2, sort_keys=True) + "\n",
        encoding="utf-8",
    )
    return manifest


def verify_manifest(pack: Path) -> list[str]:
    """复算 MANIFEST：返回问题列表（空列表 = 通过）。"""
    pack = Path(pack)
    manifest_path = pack / "MANIFEST.json"
    if not manifest_path.exists():
        return [f"缺少文件: MANIFEST.json（{pack}）"]
    try:
        manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
    except json.JSONDecodeError as exc:
        return [f"MANIFEST.json 解析失败: {exc}"]

    problems: list[str] = []
    listed: set[str] = set()
    for entry in manifest.get("files", []):
        rel = entry.get("path", "")
        listed.add(rel)
        target = pack / rel
        if not target.exists():
            problems.append(f"缺少文件: {rel}")
            continue
        actual_size = target.stat().st_size
        if actual_size != entry.get("size"):
            problems.append(f"大小不一致: {rel}（清单 {entry.get('size')}，实际 {actual_size}）")
        actual_hash = _sha256(target)
        if actual_hash != entry.get("sha256"):
            problems.append(f"哈希不一致: {rel}")
    for path in sorted(pack.rglob("*")):
        if not path.is_file():
            continue
        rel = path.relative_to(pack).as_posix()
        if rel == "MANIFEST.json":
            continue
        if rel not in listed and _is_runtime_noise(rel):
            continue
        if rel not in listed:
            problems.append(f"未登记文件: {rel}")
    return problems


def _is_runtime_noise(rel: str) -> bool:
    """运行产物内工具可能生成的字节码/依赖缓存（可再生，不计入完整性）。"""
    parts = rel.split("/")
    return "__pycache__" in parts or "node_modules" in parts or rel.endswith((".pyc", ".pyo"))


# ---------------------------------------------------------------------------
# 自测
# ---------------------------------------------------------------------------
def cmd_self_test(args) -> int:
    ok = True

    def report(name, cond):
        nonlocal ok
        print(f"[{'ok  ' if cond else 'FAIL'}] {name}")
        ok = ok and cond

    def run_in(pack: Path, argv: list[str]):
        env = {**os.environ, "PYTHONDONTWRITEBYTECODE": "1"}
        return subprocess.run([sys.executable, *argv], cwd=pack, env=env,
                              capture_output=True, text=True, timeout=300)

    with tempfile.TemporaryDirectory() as tmp:
        pack = Path(tmp) / "pack"
        manifest = build_pack(pack, generated_at="1970-01-01T00:00:00Z", commit="0" * 40)

        required = [
            "01-data-contract/object.schema.json",
            "06-evolution-contract/compatibility.rules.yaml",
            "05-audit-contract/verify.tool",
            "vectors/audit/valid-digest.chain.json",
            "vectors/audit/digest-events.json",
            "vectors/evolution/schema-v2-minor.json",
            "tools/contract-checker",
            "tools/audit-verifier",
            "tools/lib/eis_common.py",
            "tools/lib/eis_compat.py",
            "README.md",
            "MANIFEST.json",
        ]
        missing = [path for path in required if not (pack / path).exists()]
        report(f"必需路径齐全（缺失 {missing}）" if missing else "必需路径齐全", not missing)

        problems = verify_manifest(pack)
        report(f"MANIFEST 复算通过（问题 {problems[:2]}）" if problems else "MANIFEST 复算通过",
               not problems)

        paths = [entry["path"] for entry in manifest["files"]]
        report("文件列表有序且无重复",
               paths == sorted(paths) and len(paths) == len(set(paths)))
        report("无缓存/字节码文件",
               not any("__pycache__" in path or path.endswith(".pyc") for path in paths))

        readme = (pack / "README.md").read_text(encoding="utf-8")
        report("README 注入规范版本与文件数",
               manifest["spec_version"] in readme and str(len(manifest["files"])) in readme)

        pack2 = Path(tmp) / "pack2"
        build_pack(pack2, generated_at="1970-01-01T00:00:00Z", commit="0" * 40)
        report("固定时间与 commit 时 MANIFEST 字节一致",
               (pack / "MANIFEST.json").read_bytes() == (pack2 / "MANIFEST.json").read_bytes())

        tampered = pack2 / "01-data-contract" / "object.schema.json"
        tampered.write_bytes(tampered.read_bytes() + b"\n")
        report("篡改文件后 MANIFEST 校验必须报错", bool(verify_manifest(pack2)))
        (pack2 / "01-data-contract" / "extra.txt").write_text("x", encoding="utf-8")
        report("未登记文件必须报错",
               any("extra.txt" in problem for problem in verify_manifest(pack2)))

        proc = run_in(pack, ["05-audit-contract/verify.tool", "--self-test"])
        report("包内 verify.tool --self-test", proc.returncode == 0)
        proc = run_in(pack, ["tools/audit-verifier", "--vector"])
        report("包内 audit-verifier --vector", proc.returncode == 0)
        proc = run_in(pack, ["tools/audit-verifier", "vectors/audit/valid.chain.json"])
        report("包内合法审计链验证", proc.returncode == 0)
        proc = run_in(pack, ["tools/audit-verifier", "vectors/audit/valid-digest.chain.json",
                             "--events", "vectors/audit/digest-events.json"])
        report("包内 payload_digest 链验证", proc.returncode == 0)
        proc = run_in(pack, ["tools/compatibility-checker",
                             "--old", "vectors/evolution/schema-v1.json",
                             "--new", "vectors/evolution/schema-v2-minor.json",
                             "--standalone", "--fail-on", "MAJOR"])
        report("包内兼容性判定（minor 通过）", proc.returncode == 0)
        proc = run_in(pack, ["tools/compatibility-checker",
                             "--old", "vectors/evolution/schema-v1.json",
                             "--new", "vectors/evolution/schema-v2-breaking.json",
                             "--standalone", "--fail-on", "MAJOR"])
        report("包内兼容性负例（breaking 触发阈值）", proc.returncode == 1)
        proc = run_in(pack, ["tools/contract-checker"])
        report("包内 contract-checker", proc.returncode == 0)
        report("运行包内工具后 MANIFEST 仍通过", not verify_manifest(pack))

        # npm/pnpm 形态（--npm-out）
        npm_dir = Path(tmp) / "npm"
        npm_manifest = build_pack(npm_dir, generated_at="1970-01-01T00:00:00Z",
                                  commit="0" * 40, npm=True)
        pkg = json.loads((npm_dir / "package.json").read_text(encoding="utf-8"))
        report("npm：package.json 字段与版本",
               pkg.get("name") == NPM_PACKAGE_NAME
               and pkg.get("version") == npm_manifest["spec_version"]
               and pkg.get("bin", {}).get("eis-spec") == "./bin/eis-spec.js"
               and all(d in pkg.get("files", []) for d in ("01-data-contract", "tools", "vectors", "bin")))
        packaging = {entry["path"] for entry in npm_manifest["files"] if entry["kind"] == "packaging"}
        report("npm：器包文件登记为 packaging",
               {"package.json", "bin/eis-spec.js", "LICENSE", "NOTICE"} <= packaging)
        report("npm：MANIFEST 复算通过", not verify_manifest(npm_dir))
        npm_dir2 = Path(tmp) / "npm2"
        build_pack(npm_dir2, generated_at="1970-01-01T00:00:00Z", commit="0" * 40, npm=True)
        report("npm：固定时间与 commit 时 MANIFEST 字节一致",
               (npm_dir / "MANIFEST.json").read_bytes() == (npm_dir2 / "MANIFEST.json").read_bytes())

        npm_dir3 = Path(tmp) / "npm3"
        override = "1.0.0-nightly.19700101.abc1234"
        override_manifest = build_pack(npm_dir3, generated_at="1970-01-01T00:00:00Z",
                                       commit="0" * 40, npm=True, npm_version=override)
        override_pkg = json.loads((npm_dir3 / "package.json").read_text(encoding="utf-8"))
        override_readme = (npm_dir3 / "README.md").read_text(encoding="utf-8")
        report("npm：--npm-version 覆盖包版本",
               override_pkg.get("version") == override
               and override_manifest["package_version"] == override
               and override_manifest["spec_version"] != override
               and override in override_readme)
        report("npm：非法/孤立 --npm-version 退出 2",
               main(["--npm-version", "not-semver", "--npm-out", str(Path(tmp) / "bad")]) == 2
               and main(["--npm-version", "1.0.0"]) == 2)

        node = shutil.which("node")
        if node:
            proc = subprocess.run([node, "bin/eis-spec.js", "manifest", "--json"], cwd=npm_dir,
                                  capture_output=True, text=True, timeout=120)
            report("npm：node CLI manifest --json",
                   proc.returncode == 0 and '"spec_version"' in proc.stdout)
            proc = subprocess.run([node, "bin/eis-spec.js", "verify", "--no-python"], cwd=npm_dir,
                                  capture_output=True, text=True, timeout=120)
            report("npm：node CLI verify --no-python", proc.returncode == 0)
            proc = subprocess.run([node, "bin/eis-spec.js", "verify"], cwd=npm_dir,
                                  capture_output=True, text=True, timeout=300)
            report("npm：node CLI verify（含 python 自检）", proc.returncode == 0)
            tampered_path = npm_dir / "01-data-contract" / "object.schema.json"
            original_bytes = tampered_path.read_bytes()
            tampered_path.write_bytes(original_bytes + b"\n")
            proc = subprocess.run([node, "bin/eis-spec.js", "verify", "--no-python"], cwd=npm_dir,
                                  capture_output=True, text=True, timeout=120)
            report("npm：node CLI 篡改检出", proc.returncode == 1)
            tampered_path.write_bytes(original_bytes)
            report("npm：还原后 MANIFEST 复算通过", not verify_manifest(npm_dir))
        else:
            print("[skip] 未发现 node，跳过 npm CLI 断言")

        pnpm = shutil.which("pnpm")
        if pnpm:
            pack_out = Path(tmp) / "npm-pack"
            pack_out.mkdir()
            proc = subprocess.run([pnpm, "pack", "--pack-destination", str(pack_out)], cwd=npm_dir,
                                  capture_output=True, text=True, timeout=300)
            tarballs = sorted(pack_out.glob("*.tgz"))
            report("npm：pnpm pack 产出 tarball",
                   proc.returncode == 0 and len(tarballs) == 1
                   and npm_manifest["spec_version"] in tarballs[0].name)
            if tarballs:
                listing = subprocess.run(["tar", "-tzf", str(tarballs[0])],
                                         capture_output=True, text=True, timeout=120).stdout
                report("npm：tarball 含 package.json 与 bin",
                       "package/package.json" in listing and "package/bin/eis-spec.js" in listing)
            report("npm：pack 后 MANIFEST 复算通过", not verify_manifest(npm_dir))
        else:
            print("[skip] 未发现 pnpm，跳过 pnpm pack 断言")

    print(f"自测结果: {'通过' if ok else '失败'}")
    return 0 if ok else 1


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------
def main(argv=None) -> int:
    parser = argparse.ArgumentParser(prog="build-spec-pack",
                                     description="EIS 规格包生成与校验（AI 可消费；参考实现）")
    parser.add_argument("--out", help="输出目录（默认 dist/eis-spec-pack）")
    parser.add_argument("--npm-out", metavar="DIR",
                        help="生成 npm/pnpm 包形态（package.json + bin/eis-spec.js + 规格内容）")
    parser.add_argument("--check", metavar="DIR", help="校验已有产物的 MANIFEST")
    parser.add_argument("--npm-version", metavar="V",
                        help="npm 包版本覆盖（仅与 --npm-out 同用；默认 = 规范版本）")
    parser.add_argument("--json", action="store_true", help="JSON 摘要输出")
    parser.add_argument("--self-test", action="store_true", help="自测")
    args = parser.parse_args(argv)

    if args.self_test:
        return cmd_self_test(args)
    if args.check:
        problems = verify_manifest(Path(args.check))
        if problems:
            for problem in problems:
                print(f"[FAIL] {problem}", file=sys.stderr)
            return 1
        print("[ok  ] MANIFEST 校验通过（哈希、大小与文件清单一致）")
        return 0

    if args.npm_version and not args.npm_out:
        print("--npm-version 仅与 --npm-out 一起使用", file=sys.stderr)
        return 2
    if args.npm_version and not re.match(r"^\d+\.\d+\.\d+(?:-[0-9A-Za-z.-]+)?$", args.npm_version):
        print("--npm-version 必须为合法 semver（如 1.0.0 或 1.0.0-nightly.20261017.abc1234）",
              file=sys.stderr)
        return 2

    if args.npm_out:
        out = Path(args.npm_out)
        manifest = build_pack(out, npm=True, npm_version=args.npm_version)
        print(f"[ok  ] npm 包: {len(manifest['files'])} 个文件 → {out}")
        print(f"[ok  ] package: {NPM_PACKAGE_NAME}@{manifest['package_version']}"
              "（pnpm pack 归档，不发布 registry）")
        return 0

    out = Path(args.out) if args.out else DEFAULT_OUT
    manifest = build_pack(out)
    if args.json:
        print(json.dumps({
            "out": str(out),
            "spec_version": manifest["spec_version"],
            "generated_at": manifest["generated_at"],
            "source_commit": manifest["source_commit"],
            "file_count": len(manifest["files"]),
        }, ensure_ascii=False, indent=2))
    else:
        print(f"[ok  ] spec-pack: {len(manifest['files'])} 个文件 → {out}")
        print(f"[ok  ] MANIFEST.json: spec_version={manifest['spec_version']} "
              f"commit={manifest['source_commit'] or '(unknown)'}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
