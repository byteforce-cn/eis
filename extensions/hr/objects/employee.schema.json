{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eis://extensions/hr/object/employee/v1",
  "title": "Employee",
  "description": "员工主数据。employee_no 由服务端生成；id_number_hash 为服务端派生的写入专用散列（载荷以原始 id_number 写入，写路径派生；任何读投影/命令记录均须剔除）。",
  "allOf": [
    {
      "$ref": "../../../01-data-contract/object.schema.json"
    },
    {
      "type": "object",
      "required": ["employee_no", "name", "status", "hire_date"],
      "properties": {
        "employee_no": {
          "type": "string",
          "pattern": "^EMP-[0-9]{6,}$",
          "description": "工号（服务端生成，兜底唯一）"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": ["pending_onboarding", "active", "terminated", "cancelled"],
          "description": "员工状态：待入职 / 在职 / 离职 / 取消"
        },
        "hire_date": {
          "type": "string",
          "format": "date",
          "description": "入职日期"
        },
        "employment_type": {
          "type": ["string", "null"],
          "enum": ["full_time", "part_time", "intern", "contract", null],
          "description": "雇佣类型：全职 full_time / 兼职 part_time / 实习 intern / 劳务 contract（可选，历史数据可空）"
        },
        "work_location": {
          "type": ["string", "null"],
          "minLength": 1,
          "description": "工作地点（办公地 / 城市；可选，历史数据可空）"
        },
        "org_unit_id": {
          "type": ["string", "null"],
          "format": "uuid",
          "description": "主组织单元 ID（由主岗派生）"
        },
        "contact": {
          "type": ["string", "null"]
        },
        "id_type": {
          "type": ["string", "null"],
          "enum": ["national_id", "passport", null],
          "description": "证件类型"
        },
        "id_number_hash": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$",
          "writeOnly": true,
          "description": "证件号 HMAC-SHA256 散列（小写十六进制 64 字符；服务端由 id_number 派生；非终态员工间唯一，允许离职返聘；不落读投影/命令记录）"
        },
        "terminated_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "terminated_reason": {
          "type": ["string", "null"]
        }
      }
    }
  ]
}
