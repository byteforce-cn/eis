{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eis://extensions/approval/object/approval-request/v1",
  "title": "ApprovalRequest",
  "description": "审批申请。核心元字段通过 allOf 引用（冻结）。",
  "allOf": [
    {
      "$ref": "../../../01-data-contract/object.schema.json"
    },
    {
      "type": "object",
      "required": ["operation", "target", "requester", "status"],
      "properties": {
        "operation": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.]*$",
          "description": "被审批的操作类型，如 \"accounting.voucher.post\""
        },
        "target": {
          "type": "object",
          "required": ["type", "id"],
          "properties": {
            "type": {
              "type": "string"
            },
            "id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "description": "被审批的目标业务对象"
        },
        "requester": {
          "type": "string",
          "format": "uuid",
          "description": "申请人"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected", "withdrawn"],
          "description": "状态：待审 / 通过 / 驳回 / 发起方撤回"
        },
        "section_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "description": "区块级流转关联的 ApprovalSection ID（数组顺序 = 处理顺序，与各区块 step_order 一致；简单模式省略）"
        },
        "withdrawn_reason": {
          "type": ["string", "null"],
          "description": "撤回原因（仅 withdrawn 时有意义）"
        },
        "summary": {
          "type": ["string", "null"]
        }
      }
    }
  ]
}
