{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eis://extensions/approval/object/approval-decision/v1",
  "title": "ApprovalDecision",
  "description": "审批决定。不变量：decider != requester（rules/no-self-approval.yaml）。",
  "allOf": [
    {
      "$ref": "../../../01-data-contract/object.schema.json"
    },
    {
      "type": "object",
      "required": ["request_id", "decider", "outcome", "decided_at"],
      "properties": {
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "decider": {
          "type": "string",
          "format": "uuid",
          "description": "决定人"
        },
        "outcome": {
          "type": "string",
          "enum": ["approve", "reject"]
        },
        "comment": {
          "type": ["string", "null"],
          "description": "审批意见"
        },
        "decided_at": {
          "type": "string",
          "format": "date-time",
          "description": "决定时间（UTC 微秒）"
        }
      }
    }
  ]
}
