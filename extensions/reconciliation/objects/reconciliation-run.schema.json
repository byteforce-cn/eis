{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eis://extensions/reconciliation/object/run/v1",
  "title": "ReconciliationRun",
  "description": "一次对账运行。run_key = domain:period:sequence 是幂等身份；同一 run_key 只允许一个当前对象（迁移提供部分唯一索引）。状态机 running → succeeded|failed|skipped。",
  "allOf": [
    {
      "$ref": "../../../01-data-contract/object.schema.json"
    },
    {
      "type": "object",
      "required": [
        "domain",
        "period",
        "sequence",
        "run_key",
        "status",
        "tolerance_amount",
        "tolerance_quantity",
        "source_count",
        "target_count",
        "difference_count",
        "started_at"
      ],
      "properties": {
        "domain": {
          "type": "string",
          "minLength": 1,
          "description": "对账域（order / payment / inventory / ledger 等），由使用方命名"
        },
        "period": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}$",
          "description": "对账期间（YYYY-MM）；期间边界复用 03 时间契约"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "description": "同 (domain, period) 内的显式运行序号；重跑必须换序号"
        },
        "run_key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*:[0-9]{4}-[0-9]{2}:[0-9]+$",
          "description": "run_key = domain:period:sequence（幂等身份，当前对象唯一）"
        },
        "status": {
          "type": "string",
          "enum": ["running", "succeeded", "failed", "skipped"],
          "description": "运行状态：进行中 / 成功 / 失败 / 跳过"
        },
        "tolerance_amount": {
          "type": "string",
          "pattern": "^\\d+(\\.\\d{1,2})?$",
          "description": "金额容忍度（绝对差 ≤ 容忍度视为 matched；受控十进制字符串）"
        },
        "tolerance_quantity": {
          "type": "string",
          "pattern": "^\\d+(\\.\\d+)?$",
          "description": "数量容忍度（绝对差 ≤ 容忍度视为 matched）"
        },
        "source_count": {
          "type": "integer",
          "minimum": 0,
          "description": "来源侧记录数"
        },
        "target_count": {
          "type": "integer",
          "minimum": 0,
          "description": "目标侧记录数"
        },
        "difference_count": {
          "type": "integer",
          "minimum": 0,
          "description": "本次运行落库的差异记录数（含 matched）"
        },
        "started_at": {
          "type": "string",
          "format": "date-time",
          "description": "运行开始时间（UTC）"
        },
        "finished_at": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "终态时间；running 时为 null"
        },
        "failure_reason": {
          "type": ["string", "null"],
          "description": "失败原因（机器可读摘要，不承载业务数据）"
        }
      }
    }
  ]
}
