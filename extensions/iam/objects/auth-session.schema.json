{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eis://extensions/iam/object/auth-session/v1",
  "title": "AuthSession",
  "description": "登录与令牌签发关联的认证会话事实。",
  "allOf": [
    {
      "$ref": "../../../01-data-contract/object.schema.json"
    },
    {
      "type": "object",
      "required": ["account_id", "client_id", "auth_method", "jti", "status", "expires_at"],
      "properties": {
        "account_id": {
          "type": "string",
          "format": "uuid"
        },
        "client_id": {
          "type": "string"
        },
        "auth_method": {
          "type": "string"
        },
        "jti": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": ["active", "revoked", "expired"]
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  ]
}
