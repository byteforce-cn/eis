{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eis://extensions/iam/object/credential/v1",
  "title": "Credential",
  "description": "用户认证凭证。secret_hash 为写入专用字段，任何读投影均须剔除。",
  "allOf": [
    {
      "$ref": "../../../01-data-contract/object.schema.json"
    },
    {
      "type": "object",
      "required": ["account_id", "type", "secret_hash", "status", "must_change"],
      "properties": {
        "account_id": {
          "type": "string",
          "format": "uuid"
        },
        "type": {
          "type": "string",
          "enum": ["password"]
        },
        "secret_hash": {
          "type": "string",
          "minLength": 1,
          "writeOnly": true
        },
        "status": {
          "type": "string",
          "enum": ["active", "revoked"]
        },
        "must_change": {
          "type": "boolean"
        },
        "rotated_at": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      }
    }
  ]
}
