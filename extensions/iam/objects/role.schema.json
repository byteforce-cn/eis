{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eis://extensions/iam/object/role/v1",
  "title": "Role",
  "description": "IAM 管理面角色镜像；判定语义遵循核心 04 授权契约。",
  "allOf": [
    {
      "$ref": "../../../01-data-contract/object.schema.json"
    },
    {
      "type": "object",
      "required": ["key", "name", "permissions"],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9_.-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "permissions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.]*$"
          }
        },
        "built_in": {
          "type": "boolean",
          "default": false
        }
      }
    }
  ]
}
